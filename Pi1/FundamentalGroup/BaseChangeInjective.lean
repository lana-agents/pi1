module

public import Pi1.FundamentalGroup.GaloisQuotient
public import Pi1.Mathlib.CategoryTheory.Galois.FiberAutMapInjective
public import Pi1.RingTheory.FiniteEtale.FieldDescent

/-!
# Injectivity of `π₁ᵉᵗ(X_Ω) → π₁ᵉᵗ(X)` for affine `X`

Let `k` be a field, `Ω ⊇ k` a separably closed algebraic separable extension (a separable
closure), and `X = Spec R` an affine `k`-scheme, `X_Ω = Spec (Ω ⊗[k] R)`. If `X_Ω` is connected,
then the map `Δ_X = π₁ᵉᵗ(X_Ω) → π₁ᵉᵗ(X) = Π_X` is injective
(`AlgebraicGeometry.FiniteEtale.fundamentalGroupMap_baseChange_injective`); this is the
left half of the homotopy exact sequence `1 → Δ_X → Π_X → G_k → 1` (SGA 1 IX.6.1).

Proof: by the Galois-theoretic criterion `PreGaloisCategory.fiberAutMap_injective` it suffices
that every finite étale `X_Ω`-scheme `A'` is a subobject of the base change of a finite étale
`X`-scheme (`exists_mono_pullback_baseChange`). Writing `A' = Spec B`, the finite étale
`Ω ⊗[k] R`-algebra `B` descends to a finite étale `K ⊗[k] R`-algebra `B'` for a finite
subextension `K` (`Algebra.FiniteEtale.exists_descent_intermediateField`); then `Y = Spec B'` is
finite étale over `X` (as `K / k` is finite separable), and `A' → Y ×_X X_Ω` is a monomorphism
because `B` is generated by the images of `B'` and `Ω ⊗[k] R`.
-/

@[expose] public section

universe u

noncomputable section

open CategoryTheory Limits TensorProduct

namespace AlgebraicGeometry

/-- A morphism `Spec B ⟶ Spec B' ×_{Spec R} Spec T` induced by ring maps `B' → B ← T` is a
monomorphism if `B` is generated by the images of `B'` and `T` (in the sense that ring maps out of
`B` are determined by their restrictions). -/
lemma mono_pullback_lift_Spec {R T B B' : CommRingCat.{u}} (p : R ⟶ B') (q : R ⟶ T)
    (ψ : B' ⟶ B) (α : T ⟶ B) (h : Spec.map ψ ≫ Spec.map p = Spec.map α ≫ Spec.map q)
    (hgen : ∀ (C : CommRingCat.{u}) (a b : B ⟶ C), ψ ≫ a = ψ ≫ b → α ≫ a = α ≫ b → a = b) :
    Mono (pullback.lift (Spec.map ψ) (Spec.map α) h) := by
  constructor
  intro Z a b hab
  have h1 : a ≫ Spec.map ψ = b ≫ Spec.map ψ := by
    simpa using congr($hab ≫ pullback.fst _ _)
  have h2 : a ≫ Spec.map α = b ≫ Spec.map α := by
    simpa using congr($hab ≫ pullback.snd _ _)
  apply ext_of_isAffine
  have key (S : CommRingCat.{u}) (f : S ⟶ B) (c : Z ⟶ Spec B) :
      (Scheme.ΓSpecIso S).inv ≫ (c ≫ Spec.map f).appTop =
        f ≫ (Scheme.ΓSpecIso B).inv ≫ c.appTop := by
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc]
  have e1 := key _ ψ a
  have e2 := key _ α a
  rw [h1, key] at e1
  rw [h2, key] at e2
  have := hgen _ _ _ e1.symm e2.symm
  simpa using congr((Scheme.ΓSpecIso B).hom ≫ $this)

section TensorLemmas

variable {S T B B' : Type u} [CommRing S] [CommRing T] [CommRing B] [CommRing B'] [Algebra S T]
  [Algebra S B'] [Algebra T B]

lemma _root_.AlgEquiv.symm_one_tmul_algebraMap (e : B ≃ₐ[T] T ⊗[S] B') (s : S) :
    e.symm (1 ⊗ₜ algebraMap S B' s) = algebraMap T B (algebraMap S T s) := by
  rw [Algebra.algebraMap_eq_smul_one s, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
    Algebra.smul_def, mul_one]
  rw [show (algebraMap S T s ⊗ₜ[S] (1 : B')) = algebraMap T (T ⊗[S] B') (algebraMap S T s) by
    simp [Algebra.TensorProduct.algebraMap_apply], AlgEquiv.commutes]

lemma _root_.AlgEquiv.ringHom_ext_of_tensor (e : B ≃ₐ[T] T ⊗[S] B') {C : Type u} [CommRing C]
    (a b : B →+* C) (ha : ∀ y, a (e.symm (1 ⊗ₜ y)) = b (e.symm (1 ⊗ₜ y)))
    (hb : ∀ t, a (algebraMap T B t) = b (algebraMap T B t)) : a = b := by
  have hy (y : T ⊗[S] B') : a (e.symm y) = b (e.symm y) := by
    induction y using TensorProduct.induction_on with
    | zero => simp
    | tmul t y =>
      have : (t ⊗ₜ y : T ⊗[S] B') = algebraMap T _ t * (1 ⊗ₜ y) := by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self_apply,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [this, map_mul, AlgEquiv.commutes, map_mul, map_mul, ha, hb]
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
  ext x
  simpa using hy (e x)

end TensorLemmas

namespace FiniteEtale

/-- The finite étale `Spec T`-scheme `Spec B` of a finite étale `T`-algebra `B`. -/
def ofAlgebra (T B : Type u) [CommRing T] [CommRing B] [Algebra T B]
    [Algebra.FiniteEtale T B] : FiniteEtale (Spec (.of T)) :=
  haveI : IsFiniteEtale (Spec.map (CommRingCat.ofHom (algebraMap T B))) := by
    rw [IsFiniteEtale.SpecMap_iff, CommRingCat.hom_ofHom, RingHom.finiteEtale_algebraMap_iff]
    infer_instance
  mk (Spec.map (CommRingCat.ofHom (algebraMap T B)))

/-- The ring map `T → Γ(A)` of a finite étale `Spec T`-scheme `A`. -/
def ringHomΓ {T : CommRingCat.{u}} (A : FiniteEtale (Spec T)) : T ⟶ Γ(A.left, ⊤) :=
  (Scheme.ΓSpecIso T).inv ≫ A.hom.appTop

lemma hom_eq_isoSpec_hom_comp {T : CommRingCat.{u}} (A : FiniteEtale (Spec T)) :
    A.hom = A.left.isoSpec.hom ≫ Spec.map (ringHomΓ A) := by
  rw [ringHomΓ, Spec.map_comp, ← Category.assoc,
    Scheme.isoSpec_hom_naturality (X := A.left) (Y := Spec T) A.hom, Category.assoc,
    Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
    Category.comp_id]

lemma finiteEtale_ringHomΓ {T : CommRingCat.{u}} (A : FiniteEtale (Spec T)) :
    (ringHomΓ A).hom.FiniteEtale := by
  rw [← IsFiniteEtale.SpecMap_iff]
  have : Spec.map (ringHomΓ A) = A.left.isoSpec.inv ≫ A.hom := by
    rw [hom_eq_isoSpec_hom_comp, Iso.inv_hom_id_assoc]
  rw [this]
  haveI : IsFiniteEtale A.left.isoSpec.inv := {}
  infer_instance

variable {k Ω R : Type u} [Field k] [Field Ω] [Algebra k Ω] [CommRing R] [Algebra k R]

variable (k Ω R) in
/-- The projection `X_Ω = Spec (Ω ⊗[k] R) ⟶ X = Spec R`. -/
def baseChangeSpec : Spec (.of (Ω ⊗[k] R)) ⟶ Spec (.of R) :=
  Spec.map (CommRingCat.ofHom
    (Algebra.TensorProduct.includeRight : R →ₐ[k] Ω ⊗[k] R).toRingHom)

/-- `R → K ⊗[k] R` is finite étale for a finite separable extension `K / k`. -/
lemma finiteEtale_includeRight (K : Type u) [Field K] [Algebra k K] [FiniteDimensional k K]
    [Algebra.IsSeparable k K] :
    (Algebra.TensorProduct.includeRight : R →ₐ[k] K ⊗[k] R).toRingHom.FiniteEtale := by
  haveI : Algebra.FormallyEtale k K := Algebra.FormallyEtale.of_isSeparable k K
  haveI : Algebra.FinitePresentation k K :=
    (Algebra.FinitePresentation.of_finiteType (R := k) (A := K)).mp inferInstance
  haveI : Algebra.Etale k K := ⟨inferInstance, inferInstance⟩
  have h1 : (algebraMap R (R ⊗[k] K)).FiniteEtale :=
    RingHom.finiteEtale_algebraMap_iff.mpr ⟨⟩
  have e : (Algebra.TensorProduct.includeRight : R →ₐ[k] K ⊗[k] R).toRingHom =
      (Algebra.TensorProduct.comm k R K).toRingEquiv.toRingHom.comp
        (algebraMap R (R ⊗[k] K)) := by
    ext r
    simp [Algebra.TensorProduct.algebraMap_apply]
  rw [e]
  exact RingHom.FiniteEtale.respectsIso.1 _ _ h1

/-- **Every finite étale `X_Ω`-scheme is a subobject of the base change of a finite étale
`X`-scheme**, for `X = Spec R` affine over `k` and `Ω / k` algebraic and separable. -/
theorem exists_mono_pullback_baseChange [Algebra.IsSeparable k Ω]
    (A' : FiniteEtale (Spec (.of (Ω ⊗[k] R)))) :
    ∃ (Y : FiniteEtale (Spec (.of R))) (i : A' ⟶ (pullback (baseChangeSpec k Ω R)).obj Y),
      Mono i := by
  let B : CommRingCat.{u} := Γ(A'.left, ⊤)
  letI : Algebra (Ω ⊗[k] R) B := (ringHomΓ A').hom.toAlgebra
  haveI : Algebra.FiniteEtale (Ω ⊗[k] R) B := finiteEtale_ringHomΓ A'
  obtain ⟨K, hK, B', _, _, hB', ⟨e⟩⟩ :=
    Algebra.FiniteEtale.exists_descent_intermediateField (k := k) (Ω := Ω) (A := R) B
  letI := Algebra.FiniteEtale.algTensor R K
  haveI : Algebra.IsSeparable k K := Algebra.isSeparable_tower_bot_of_isSeparable k K Ω
  let incR : R →+* K ⊗[k] R :=
    (Algebra.TensorProduct.includeRight : R →ₐ[k] K ⊗[k] R).toRingHom
  let incΩ : R →+* Ω ⊗[k] R :=
    (Algebra.TensorProduct.includeRight : R →ₐ[k] Ω ⊗[k] R).toRingHom
  let φY : R →+* B' := (algebraMap (K ⊗[k] R) B').comp incR
  haveI : IsFiniteEtale (Spec.map (CommRingCat.ofHom (algebraMap (K ⊗[k] R) B'))) := by
    rw [IsFiniteEtale.SpecMap_iff, CommRingCat.hom_ofHom, RingHom.finiteEtale_algebraMap_iff]
    exact hB'
  haveI : IsFiniteEtale (Spec.map (CommRingCat.ofHom incR)) := by
    rw [IsFiniteEtale.SpecMap_iff, CommRingCat.hom_ofHom]
    exact finiteEtale_includeRight K
  haveI : IsFiniteEtale (Spec.map (CommRingCat.ofHom φY)) := by
    have : Spec.map (CommRingCat.ofHom φY) =
        Spec.map (CommRingCat.ofHom (algebraMap (K ⊗[k] R) B')) ≫
          Spec.map (CommRingCat.ofHom incR) := by
      rw [← Spec.map_comp]
      rfl
    rw [this]
    infer_instance
  let Y : FiniteEtale (Spec (.of R)) := mk (Spec.map (CommRingCat.ofHom φY))
  let ψ : B' →+* B := e.symm.toAlgHom.toRingHom.comp
    (Algebra.TensorProduct.includeRight :
      B' →ₐ[K ⊗[k] R] (Ω ⊗[k] R) ⊗[K ⊗[k] R] B').toRingHom
  have hψ (y : B') : ψ y = e.symm (1 ⊗ₜ y) := rfl
  have hα (t : Ω ⊗[k] R) : ringHomΓ A' t = algebraMap (Ω ⊗[k] R) B t := rfl
  have hring : CommRingCat.ofHom φY ≫ CommRingCat.ofHom ψ =
      CommRingCat.ofHom incΩ ≫ ringHomΓ A' := by
    ext r
    change ψ (algebraMap (K ⊗[k] R) B' (incR r)) = ringHomΓ A' (incΩ r)
    rw [hψ, hα, AlgEquiv.symm_one_tmul_algebraMap]
    rfl
  have h : Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom φY) =
      Spec.map (ringHomΓ A') ≫ Spec.map (CommRingCat.ofHom incΩ) := by
    rw [← Spec.map_comp, ← Spec.map_comp, hring]
  have hgen (C : CommRingCat.{u}) (a b : B ⟶ C) (ha : CommRingCat.ofHom ψ ≫ a =
      CommRingCat.ofHom ψ ≫ b) (hb : ringHomΓ A' ≫ a = ringHomΓ A' ≫ b) : a = b := by
    ext1
    exact e.ringHom_ext_of_tensor a.hom b.hom (fun y ↦ congr($ha y)) (fun t ↦ congr($hb t))
  have hmono := mono_pullback_lift_Spec (CommRingCat.ofHom φY) (CommRingCat.ofHom incΩ)
    (CommRingCat.ofHom ψ) (ringHomΓ A') h hgen
  let ℓ : A'.left ⟶ ((pullback (baseChangeSpec k Ω R)).obj Y).left :=
    A'.left.isoSpec.hom ≫ pullback.lift _ _ h
  have hw : ℓ ≫ ((pullback (baseChangeSpec k Ω R)).obj Y).hom = A'.hom := by
    rw [hom_eq_isoSpec_hom_comp A']
    change A'.left.isoSpec.hom ≫ pullback.lift _ _ h ≫ pullback.snd _ _ = _
    rw [pullback.lift_snd]
  refine ⟨Y, MorphismProperty.Over.homMk ℓ hw trivial, ?_⟩
  have : Mono ℓ := @mono_comp _ _ _ _ _ _ inferInstance _ hmono
  exact (MorphismProperty.Over.forget _ _ _ ⋙ Over.forget _).mono_of_mono_map this

/-- **`Δ_X → Π_X` is injective** (SGA 1 IX.6.1, left half of the homotopy exact sequence): for
an affine `k`-scheme `X = Spec R`, a separable closure `Ω` of `k` (any separably closed, algebraic
separable extension) with `X_Ω = Spec (Ω ⊗[k] R)` connected and a geometric point `x` of `X_Ω`,
the map `π₁ᵉᵗ(X_Ω, x) → π₁ᵉᵗ(X, x)` is injective. -/
theorem fundamentalGroupMap_baseChange_injective [Algebra.IsSeparable k Ω] [IsSepClosed Ω]
    [ConnectedSpace (Spec (.of (Ω ⊗[k] R)))] (x : Spec (.of Ω) ⟶ Spec (.of (Ω ⊗[k] R))) :
    Function.Injective (fundamentalGroupMap (baseChangeSpec k Ω R) (rfl :
      x ≫ baseChangeSpec k Ω R = _)) := fun _ _ hab ↦
  PreGaloisCategory.fiberAutMap_injective (fiber x) (pullbackFiberIso _ rfl)
    (fun A _ ↦ exists_mono_pullback_baseChange A) hab

end FiniteEtale

end AlgebraicGeometry
