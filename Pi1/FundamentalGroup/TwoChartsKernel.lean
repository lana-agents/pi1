module

public import Pi1.FundamentalGroup.TwoCharts

/-!
# The two-chart theorem for a group mapping onto `π₁ᵉᵗ(U ∩ U')`

Let `X = U ∪ U'` be as in `AlgebraicGeometry.FiniteEtale.ker_fundamentalGroupMap_eq` and let
`γ : G →* π₁ᵉᵗ(U ∩ U')` be a continuous surjection from a compact group `G` (e.g. a Galois group
acting through the generic point) such that `γ_U : G → π₁ᵉᵗ(U)` is surjective. Then the kernel of
`γ_X : G → π₁ᵉᵗ(X)` is the closed normal subgroup generated by `ker γ_U ∪ ker γ_U'`
(`AlgebraicGeometry.FiniteEtale.ker_comp_fundamentalGroupMap_eq`). Combined with descriptions
`ker γ_U = ⟨⟨S⟩⟩`, `ker γ_U' = ⟨⟨S'⟩⟩` by inertia elements this gives
`ker γ_X = ⟨⟨S ∪ S'⟩⟩`.

The group-theoretic input is `MonoidHom.ker_comp_eq_topologicalClosure`.
-/

@[expose] public section

universe u

open CategoryTheory

/-- Let `γ : G ↠ P` be a continuous surjection from a compact group and `ψ : P → Q` continuous
with kernel the closed normal subgroup generated by `γ(K)`. Then `ker (ψ ∘ γ)` is the closed
normal subgroup generated by `ker γ ∪ K`. -/
theorem MonoidHom.ker_comp_eq_topologicalClosure {G P Q : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] [Group P] [TopologicalSpace P]
    [IsTopologicalGroup P] [T2Space P] [Group Q] [TopologicalSpace Q] [T1Space Q]
    (γ : G →* P) (hγ : Continuous γ) (hγs : Function.Surjective γ) (ψ : P →* Q)
    (hψ : Continuous ψ) (K : Set G)
    (hker : ψ.ker = (Subgroup.normalClosure (γ '' K)).topologicalClosure) :
    (ψ.comp γ).ker = (Subgroup.normalClosure ((γ.ker : Set G) ∪ K)).topologicalClosure := by
  set M := (Subgroup.normalClosure ((γ.ker : Set G) ∪ K)).topologicalClosure
  haveI hMn : M.Normal := Subgroup.is_normal_topologicalClosure _
  have hMc : IsClosed (M : Set G) := Subgroup.isClosed_topologicalClosure _
  have hsub : (γ.ker : Set G) ∪ K ⊆ M :=
    (Subgroup.subset_normalClosure).trans (Subgroup.le_topologicalClosure _)
  apply le_antisymm
  · intro x hx
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply] at hx
    haveI : (M.map γ).Normal := hMn.map γ hγs
    have hM'c : IsClosed ((M.map γ : Subgroup P) : Set P) := by
      rw [Subgroup.coe_map]
      exact (hMc.isCompact.image hγ).isClosed
    have hle : ψ.ker ≤ M.map γ := by
      rw [hker]
      refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_) hM'c
      rintro _ ⟨k, hk, rfl⟩
      exact ⟨k, hsub (Or.inr hk), rfl⟩
    obtain ⟨m, hm, hmx⟩ := hle ((MonoidHom.mem_ker).mpr hx)
    have h1 : m⁻¹ * x ∈ M := hsub (Or.inl (by
      rw [SetLike.mem_coe, MonoidHom.mem_ker, map_mul, map_inv, hmx, inv_mul_cancel]))
    simpa using M.mul_mem hm h1
  · refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_) ?_
    · rintro x (hx | hx)
      · rw [SetLike.mem_coe, MonoidHom.mem_ker] at hx
        rw [SetLike.mem_coe, MonoidHom.mem_ker, MonoidHom.comp_apply, hx, map_one]
      · have : γ x ∈ ψ.ker := by
          rw [hker]
          exact Subgroup.le_topologicalClosure _
            (Subgroup.subset_normalClosure ⟨x, hx, rfl⟩)
        exact this
    · have : ((ψ.comp γ).ker : Set G) = (ψ ∘ γ) ⁻¹' {1} := by
        ext x
        simp
      rw [this]
      exact isClosed_singleton.preimage (hψ.comp hγ)

namespace AlgebraicGeometry.FiniteEtale

variable {X : Scheme.{u}} (U U' : X.Opens)

/-- **`π₁ᵉᵗ` of `X = U ∪ U'` through a group mapping onto `π₁ᵉᵗ(U ∩ U')`.** In the setting of
`ker_fundamentalGroupMap_eq`, let `γ : G → π₁ᵉᵗ(U ∩ U')` be a continuous surjection from a compact
group with `γ_U : G → π₁ᵉᵗ(U)` surjective. Then `ker (G → π₁ᵉᵗ(X))` is the closed normal subgroup
generated by `ker γ_U ∪ ker γ_U'`. -/
theorem ker_comp_fundamentalGroupMap_eq (hUU' : U ⊔ U' = ⊤) [ConnectedSpace X]
    [ConnectedSpace U] [ConnectedSpace U'] [ConnectedSpace (U ⊓ U' : X.Opens)]
    [QuasiCompact U.ι] [QuasiCompact (incl₂ U U')] [IsIso U.ι.fromNormalization]
    [IsIso (incl₂ U U').fromNormalization] [IsReduced X] [IsLocallyNoetherian X]
    {Ω : Type u} [Field Ω] [IsSepClosed Ω] (ξ : Spec (.of Ω) ⟶ (U ⊓ U' : X.Opens))
    {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
    (γ : G →* π₁ᵉᵗ(ξ)) (hγ : Continuous γ) (hγs : Function.Surjective γ)
    (hU : Function.Surjective
      ((fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)).toMonoidHom.comp γ)) :
    ((fundamentalGroupMap U.ι (rfl : (ξ ≫ incl₁ U U') ≫ U.ι = _)).toMonoidHom.comp
      ((fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)).toMonoidHom.comp γ)).ker =
      (Subgroup.normalClosure
        ((((fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)).toMonoidHom.comp
          γ).ker : Set G) ∪
        ((fundamentalGroupMap (incl₂ U U') (rfl : ξ ≫ incl₂ U U' = _)).toMonoidHom.comp
          γ).ker)).topologicalClosure := by
  -- `set`/`refine` with the big `fundamentalGroupMap` terms time out in unification, so all
  -- arguments are given explicitly.
  have himg : ⇑((fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)).toMonoidHom.comp
      γ) '' (((fundamentalGroupMap (incl₂ U U') (rfl : ξ ≫ incl₂ U U' = _)).toMonoidHom.comp
        γ).ker : Set G) =
      ⇑(fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)) ''
        (fundamentalGroupMap (incl₂ U U') (rfl : ξ ≫ incl₂ U U' = _)).toMonoidHom.ker := by
    rw [MonoidHom.coe_comp, Set.image_comp, ← MonoidHom.comap_ker, Subgroup.coe_comap,
      Set.image_preimage_eq _ hγs]
    rfl
  have key := MonoidHom.ker_comp_eq_topologicalClosure
    ((fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)).toMonoidHom.comp γ)
    ((fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)).continuous.comp hγ) hU
    (fundamentalGroupMap U.ι (rfl : (ξ ≫ incl₁ U U') ≫ U.ι = _)).toMonoidHom
    (fundamentalGroupMap U.ι (rfl : (ξ ≫ incl₁ U U') ≫ U.ι = _)).continuous
    (((fundamentalGroupMap (incl₂ U U') (rfl : ξ ≫ incl₂ U U' = _)).toMonoidHom.comp
          γ).ker : Set G)
  rw [himg] at key
  exact key (ker_fundamentalGroupMap_eq U U' hUU' ξ)

end AlgebraicGeometry.FiniteEtale
