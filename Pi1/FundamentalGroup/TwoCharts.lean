/-!
# `π₁ᵉᵗ` of a scheme covered by two opens with trivial normalizations

Let `X = U ∪ U'` be covered by two open subschemes, `U'' = U ∩ U'`, such that the normalization of
`X` in `U` and of `U'` in `U''` are trivial (e.g. `X` normal and `U`, `U''` dense), `X` reduced and
locally noetherian. For a geometric point `ξ` of `U''`, the map `ψ : π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(X)` is
surjective (`Pi1.FundamentalGroup.DenseOpen`) and its kernel is the closed normal subgroup
generated by the image of `ker (π₁ᵉᵗ(U'') ↠ π₁ᵉᵗ(U'))` under `μ : π₁ᵉᵗ(U'') → π₁ᵉᵗ(U)`
(`AlgebraicGeometry.FiniteEtale.ker_fundamentalGroupMap_eq`). This is an étale analogue of the
Seifert–van Kampen theorem in the case where the second chart only removes "punctures".

The inclusion `⊇` is functoriality (`U'' ⟶ U ⟶ X` equals `U'' ⟶ U' ⟶ X`). For `⊆`, an element
`τ` outside the subgroup is moved by a point of a finite étale `U`-cover `C` whose fibre is
`π₁ᵉᵗ(U) ⧸ V` for an open normal subgroup `V` (`PreGaloisCategory.exists_obj_stabilizer_eq`);
the restriction of `C` to `U''` descends to a `U'`-cover
(`PreGaloisCategory.exists_iso_obj_of_forall_ker_smul_eq`), so `C` extends to `X` through the
normalization (`FiniteEtale.extension`), and `ψ(τ)` moves a point of the extension.
-/

@[expose] public section

universe u

open CategoryTheory Limits MorphismProperty PreGaloisCategory

/-- In a profinite group, a closed normal subgroup `N` and an element `τ ∉ N` are separated by an
open normal subgroup `V ⊇ N`. -/
lemma exists_isOpen_normal_le_notMem {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G] {N : Subgroup G}
    [N.Normal] (hN : IsClosed (N : Set G)) {τ : G} (hτ : τ ∉ N) :
    ∃ V : Subgroup G, IsOpen (V : Set G) ∧ V.Normal ∧ N ≤ V ∧ τ ∉ V := by
  have hK : IsClosed ((fun n ↦ τ * n) '' (N : Set G)) :=
    (hN.isCompact.image (continuous_const.mul continuous_id)).isClosed
  have h1 : (1 : G) ∈ ((fun n ↦ τ * n) '' (N : Set G))ᶜ := by
    rintro ⟨n, hn, h⟩
    apply hτ
    rw [eq_inv_of_mul_eq_one_left h]
    exact N.inv_mem hn
  obtain ⟨O, hO⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hK.isOpen_compl h1
  refine ⟨O.toSubgroup ⊔ N, Subgroup.isOpen_mono le_sup_left O.isOpen', inferInstance,
    le_sup_right, fun h ↦ ?_⟩
  obtain ⟨y, hy, z, hz, hyz⟩ := Subgroup.mem_sup_of_normal_left.mp h
  exact hO hy ⟨z⁻¹, N.inv_mem hz, by rw [← hyz]; group⟩

namespace AlgebraicGeometry

/-- Transport finite étaleness of a relative normalization along an equality of morphisms (the
instance arguments may differ). -/
lemma Scheme.Hom.isFiniteEtale_of_eq {W T : Scheme.{u}} {g h : W ⟶ T} (H : g = h)
    [QuasiCompact g] [QuasiSeparated g] [QuasiCompact h] [QuasiSeparated h]
    (hg : IsFiniteEtale g.fromNormalization) : IsFiniteEtale h.fromNormalization := by
  subst H
  exact hg

namespace FiniteEtale

lemma fundamentalGroupMap_eq_of_eq {X Y : Scheme.{u}} {Ω : Type u} [Field Ω] {f g : Y ⟶ X}
    (e : f = g) {ξ : Spec (.of Ω) ⟶ Y} {η : Spec (.of Ω) ⟶ X} (h : ξ ≫ f = η) (h' : ξ ≫ g = η) :
    fundamentalGroupMap f h = fundamentalGroupMap g h' := by
  subst e
  rfl

variable {X : Scheme.{u}} (U U' : X.Opens)

/-- The inclusion `U ∩ U' ⟶ U`. -/
noncomputable abbrev incl₁ : (U ⊓ U' : X.Opens).toScheme ⟶ U := X.homOfLE inf_le_left
/-- The inclusion `U ∩ U' ⟶ U'`. -/
noncomputable abbrev incl₂ : (U ⊓ U' : X.Opens).toScheme ⟶ U' := X.homOfLE inf_le_right

lemma incl₁_ι : incl₁ U U' ≫ U.ι = incl₂ U U' ≫ U'.ι := by
  simp [incl₁, incl₂, Scheme.homOfLE_ι]

/-- The restriction of a `U`-cover to `U ∩ U'` is the base change of `X ⟶ U'`. -/
lemma isPullback_restrict (C : FiniteEtale U) :
    IsPullback (pullback.fst C.hom (incl₁ U U')) (pullback.snd C.hom (incl₁ U U') ≫ incl₂ U U')
      (C.hom ≫ U.ι) U'.ι :=
  (IsPullback.of_hasPullback _ _).paste_vert (isPullback_opens_inf U U')

/-- If the restriction of a finite étale `U`-scheme `C` to `U ∩ U'` comes from a finite étale
`U'`-scheme `W`, then the normalization of `U'` in `C ×_X U'` is finite étale. -/
lemma isFiniteEtale_fromNormalization_of_iso [QuasiCompact U.ι] [QuasiCompact (incl₂ U U')]
    [IsIso (incl₂ U U').fromNormalization] (C : FiniteEtale U) (W : FiniteEtale U')
    (f : (pullback (incl₂ U U')).obj W ≅ (pullback (incl₁ U U')).obj C)
    [IsReduced (Limits.pullback W.hom (incl₂ U U'))] :
    IsFiniteEtale (pullback.snd (C.hom ≫ U.ι) U'.ι).fromNormalization := by
  -- `C ×_X U'` is `C|_{U ∩ U'}`, mapping to `U'`
  have hP := isPullback_restrict U U' C
  have h1 : pullback.snd (C.hom ≫ U.ι) U'.ι =
      hP.isoPullback.symm.hom ≫ (pullback.snd C.hom (incl₁ U U') ≫ incl₂ U U') := by
    rw [Iso.symm_hom, IsPullback.isoPullback_inv_snd]
  -- `C|_{U ∩ U'} ≅ W|_{U ∩ U'}`, mapping to `U'` through `W`
  let a := pullback.fst W.hom (incl₂ U U')
  let e' : ((pullback (incl₁ U U')).obj C).left ≅ Limits.pullback W.hom (incl₂ U U') :=
    (MorphismProperty.Over.forget _ _ _ ⋙ Over.forget _).mapIso f.symm
  have h2 : pullback.snd C.hom (incl₁ U U') ≫ incl₂ U U' = e'.hom ≫ (a ≫ W.hom) := by
    have hw : f.inv.left ≫ pullback.snd W.hom (incl₂ U U') = pullback.snd C.hom (incl₁ U U') :=
      Over.w f.inv.hom
    change _ = f.inv.left ≫ pullback.fst W.hom (incl₂ U U') ≫ W.hom
    rw [pullback.condition, ← reassoc_of% hw]
  have := Scheme.Hom.isIso_fromNormalization_pullback_fst (incl₂ U U') W.hom
  have hiso := Scheme.Hom.isIso_normalizationCompDesc a W.hom
  have hW : IsFiniteEtale (a ≫ W.hom).fromNormalization := by
    rw [← (a ≫ W.hom).normalizationDesc_comp a W.hom rfl]
    exact (MorphismProperty.cancel_left_of_respectsIso @IsFiniteEtale _ _).mpr inferInstance
  have h3 : IsFiniteEtale (e'.hom ≫ (a ≫ W.hom)).fromNormalization := by
    rw [← Scheme.Hom.normalizationIsoOfIso_hom_fromNormalization]
    exact (MorphismProperty.cancel_left_of_respectsIso @IsFiniteEtale _ _).mpr hW
  have h4 : IsFiniteEtale (pullback.snd C.hom (incl₁ U U') ≫ incl₂ U U').fromNormalization :=
    Scheme.Hom.isFiniteEtale_of_eq h2.symm h3
  have h5 : IsFiniteEtale (hP.isoPullback.symm.hom ≫
      (pullback.snd C.hom (incl₁ U U') ≫ incl₂ U U')).fromNormalization := by
    rw [← Scheme.Hom.normalizationIsoOfIso_hom_fromNormalization]
    exact (MorphismProperty.cancel_left_of_respectsIso @IsFiniteEtale _ _).mpr h4
  exact Scheme.Hom.isFiniteEtale_of_eq h1.symm h5

lemma aut_mul_app {C : Type*} [Category C] {F : C ⥤ FintypeCat.{u}} (σ τ : Aut F) (A : C)
    (x : F.obj A) : (σ * τ).hom.app A x = σ.hom.app A (τ.hom.app A x) :=
  rfl

/-- **`π₁ᵉᵗ` of `X = U ∪ U'`.** If the normalizations of `X` in `U` and of `U'` in `U ∩ U'` are
trivial, the kernel of `π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(X)` is the closed normal subgroup generated by the image
of `ker (π₁ᵉᵗ(U ∩ U') ↠ π₁ᵉᵗ(U'))`. -/
theorem ker_fundamentalGroupMap_eq (hUU' : U ⊔ U' = ⊤) [ConnectedSpace X] [ConnectedSpace U]
    [ConnectedSpace U'] [ConnectedSpace (U ⊓ U' : X.Opens)] [QuasiCompact U.ι]
    [QuasiCompact (incl₂ U U')] [IsIso U.ι.fromNormalization]
    [IsIso (incl₂ U U').fromNormalization] [IsReduced X] [IsLocallyNoetherian X]
    {Ω : Type u} [Field Ω] [IsSepClosed Ω] (ξ : Spec (.of Ω) ⟶ (U ⊓ U' : X.Opens)) :
    (fundamentalGroupMap U.ι (rfl : (ξ ≫ incl₁ U U') ≫ U.ι = _)).toMonoidHom.ker =
      (Subgroup.normalClosure
        ((fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)) ''
          (fundamentalGroupMap (incl₂ U U') (rfl : ξ ≫ incl₂ U U' = _)).toMonoidHom.ker)
        ).topologicalClosure := by
  set ψ := fundamentalGroupMap U.ι (rfl : (ξ ≫ incl₁ U U') ≫ U.ι = _)
  set μ := fundamentalGroupMap (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)
  set μ' := fundamentalGroupMap (incl₂ U U') (rfl : ξ ≫ incl₂ U U' = _)
  set N := (Subgroup.normalClosure (μ '' μ'.toMonoidHom.ker)).topologicalClosure
  haveI hNn : N.Normal := Subgroup.is_normal_topologicalClosure _
  apply le_antisymm
  · intro τ hτ
    rw [MonoidHom.mem_ker] at hτ
    by_contra hτN
    obtain ⟨V, hVo, hVn, hNV, hτV⟩ :=
      exists_isOpen_normal_le_notMem (Subgroup.isClosed_topologicalClosure _) hτN
    obtain ⟨C, c, hc, htrans⟩ := exists_obj_stabilizer_eq (fiber (ξ ≫ incl₁ U U')) V hVo
    -- the elements of `N` act trivially on the fibre of `C`
    have hfix (σ) (hσ : σ ∈ N) (x) : σ.hom.app C x = x := by
      obtain ⟨ρ, rfl⟩ := htrans x
      have h1 : (ρ⁻¹ * σ * ρ).hom.app C c = c := (hc _).mpr (by
        simpa [mul_assoc] using hVn.conj_mem σ (hNV hσ) ρ⁻¹)
      have h3 : (σ * ρ).hom.app C c = ρ.hom.app C c := by
        rw [← show ρ * (ρ⁻¹ * σ * ρ) = σ * ρ by group, aut_mul_app, h1]
      rwa [aut_mul_app] at h3
    -- `C|_{U ∩ U'}` descends to `U'`
    have hsurj : Function.Surjective (fiberAutMap
        (pullbackFiberIso (incl₂ U U') (rfl : ξ ≫ incl₂ U U' = _))) :=
      fundamentalGroupMap_surjective_of_isIso_fromNormalization (incl₂ U U') rfl
    obtain ⟨W, ⟨f⟩⟩ := exists_iso_obj_of_forall_ker_smul_eq
      (pullbackFiberIso (incl₂ U U') (rfl : ξ ≫ incl₂ U U' = _)) hsurj
      ((pullback (incl₁ U U')).obj C) (by
        intro k hk b
        have hk' : μ k ∈ N := Subgroup.le_topologicalClosure _
          (Subgroup.subset_normalClosure ⟨k, (MonoidHom.mem_ker).mpr hk, rfl⟩)
        let e := pullbackFiberIso (incl₁ U U') (rfl : ξ ≫ incl₁ U U' = _)
        have hie (y) : e.inv.app C (e.hom.app C y) = y := FintypeCat.hom_inv_id_apply (e.app C) y
        have h := hfix _ hk' (e.hom.app C b)
        change (fiberAutMap e k).hom.app C (e.hom.app C b) = _ at h
        rw [fiberAutMap_hom_app_apply, hie] at h
        have h' := congrArg (e.inv.app C) h
        rwa [hie, hie] at h')
    -- so `C` extends to `X`
    haveI : IsReduced (U' : Scheme.{u}) := isReduced_of_isOpenImmersion U'.ι
    haveI : IsReduced (U ⊓ U' : X.Opens) := isReduced_of_isOpenImmersion (U ⊓ U').ι
    haveI : IsReduced (Limits.pullback W.hom (incl₂ U U')) :=
      isReduced_of_etale (pullback.snd W.hom (incl₂ U U'))
    haveI := isFiniteEtale_normalization_of_sup U C U' hUU'
      (isFiniteEtale_fromNormalization_of_iso U U' C W f)
    -- `ψ τ = 1` acts trivially on the fibre of the extension, hence `τ` on that of `C`
    let g := extensionIso U C
    have h1 := fiberAutMap_eq_one_apply (pullbackFiberIso U.ι (rfl : (ξ ≫ incl₁ U U') ≫ U.ι = _))
      hτ (extension U C) ((fiber (ξ ≫ incl₁ U U')).map g.inv c)
    have h2 : τ.hom.app _ ((fiber (ξ ≫ incl₁ U U')).map g.inv c) =
        (fiber (ξ ≫ incl₁ U U')).map g.inv (τ.hom.app C c) := by
      have := ConcreteCategory.congr_hom (τ.hom.naturality g.inv) c
      simp only [ConcreteCategory.comp_apply] at this
      exact this
    rw [h2] at h1
    have hgi (y) : (fiber (ξ ≫ incl₁ U U')).map g.hom ((fiber (ξ ≫ incl₁ U U')).map g.inv y) = y :=
      FintypeCat.inv_hom_id_apply ((fiber (ξ ≫ incl₁ U U')).mapIso g) y
    have h3 := congrArg ((fiber (ξ ≫ incl₁ U U')).map g.hom) h1
    rw [hgi, hgi] at h3
    exact hτV ((hc τ).mp h3)
  · refine Subgroup.topologicalClosure_minimal _ ?_ ?_
    · refine Subgroup.normalClosure_le_normal ?_
      rintro _ ⟨k, hk, rfl⟩
      rw [SetLike.mem_coe, MonoidHom.mem_ker] at hk
      rw [SetLike.mem_coe, MonoidHom.mem_ker]
      have h' : (ξ ≫ incl₂ U U') ≫ U'.ι = (ξ ≫ incl₁ U U') ≫ U.ι := by
        rw [Category.assoc, Category.assoc, incl₁_ι]
      have hc1 := fundamentalGroupMap_comp (incl₁ U U') U.ι rfl rfl
        (by rw [Category.assoc] : ξ ≫ incl₁ U U' ≫ U.ι = (ξ ≫ incl₁ U U') ≫ U.ι)
      have hc2 := fundamentalGroupMap_comp (incl₂ U U') U'.ι rfl h'
        (by rw [← Category.assoc, h'] : ξ ≫ incl₂ U U' ≫ U'.ι = (ξ ≫ incl₁ U U') ≫ U.ι)
      have heq := fundamentalGroupMap_eq_of_eq (incl₁_ι U U')
        (by rw [← Category.assoc] : ξ ≫ incl₁ U U' ≫ U.ι = (ξ ≫ incl₁ U U') ≫ U.ι)
        (by rw [← Category.assoc, h'] : ξ ≫ incl₂ U U' ≫ U'.ι = (ξ ≫ incl₁ U U') ≫ U.ι)
      have := congrArg (fun φ ↦ φ k) (hc1.symm.trans (heq.trans hc2))
      simp only [ContinuousMonoidHom.comp_toFun] at this
      change ψ (μ k) = 1
      rw [this]
      change fundamentalGroupMap U'.ι h' (μ' k) = 1
      rw [show μ' k = 1 from hk, map_one]
    · have : (ψ.toMonoidHom.ker : Set π₁ᵉᵗ(ξ ≫ incl₁ U U')) = ψ ⁻¹' {1} := by
        ext x
        simp
      rw [this]
      exact isClosed_singleton.preimage ψ.continuous

end FiniteEtale

end AlgebraicGeometry
