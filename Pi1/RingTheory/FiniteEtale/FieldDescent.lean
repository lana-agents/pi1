module

public import Mathlib.RingTheory.Smooth.NoetherianDescent
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Pi1.RingTheory.FiniteEtale.Descent

/-!
# Finite étale algebras over `Ω ⊗[k] A` descend to a finite subextension

Let `k` be a field, `Ω ⊇ k` an algebraic extension and `A` a `k`-algebra. Every finite étale
`Ω ⊗[k] A`-algebra `B` is defined over `K ⊗[k] A` for a finite subextension `K` of `Ω / k`:
there is a finite étale `K ⊗[k] A`-algebra `B'` with `B ≅ (Ω ⊗[k] A) ⊗[K ⊗[k] A] B'`
(`Algebra.FiniteEtale.exists_descent_intermediateField`).

This is the limit argument behind `FEt(X_Ω) = colim_K FEt(X_K)` for affine `X`, used for the
injectivity of `π₁ᵉᵗ(X_Ω) → π₁ᵉᵗ(X)` (SGA 1 IX.6.1).

Proof: by Mathlib's noetherian descent of étale algebras (`Algebra.Etale.exists_subalgebra_fg`)
`B` comes from an étale algebra over a finitely generated `A`-subalgebra `A₀` of `Ω ⊗[k] A`; the
finitely many generators of `A₀` lie in the image of `K ⊗[k] A` for `K` generated by finitely
many algebraic elements, and finiteness descends along the faithfully flat map
`K ⊗[k] A → Ω ⊗[k] A ≅ (K ⊗[k] A) ⊗[K] Ω`.
-/

@[expose] public section

universe u

open TensorProduct

noncomputable section

namespace Algebra.FiniteEtale

variable {k Ω A : Type u} [Field k] [Field Ω] [Algebra k Ω] [CommRing A] [Algebra k A]

variable (A) in
/-- The inclusion `K ⊗[k] A → Ω ⊗[k] A` for an intermediate field `K` of `Ω / k`. -/
def inclTensor (K : IntermediateField k Ω) : K ⊗[k] A →ₐ[K] Ω ⊗[k] A :=
  Algebra.TensorProduct.map (Algebra.ofId K Ω) (AlgHom.id k A)

@[simp]
lemma inclTensor_tmul (K : IntermediateField k Ω) (x : K) (a : A) :
    inclTensor A K (x ⊗ₜ a) = (x : Ω) ⊗ₜ a := rfl

lemma inclTensor_injective (K : IntermediateField k Ω) : Function.Injective (inclTensor A K) := by
  have : Function.Injective (LinearMap.rTensor A (K.val.toLinearMap : K →ₗ[k] Ω)) :=
    Module.Flat.rTensor_preserves_injective_linearMap _ K.val.injective
  convert this using 1
  funext x
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul x a => rfl
  | add x y hx hy => rw [map_add, map_add, hx, hy]

lemma inclTensor_comp_map_inclusion {K L : IntermediateField k Ω} (h : K ≤ L) (x : K ⊗[k] A) :
    inclTensor A L (Algebra.TensorProduct.map (IntermediateField.inclusion h) (AlgHom.id k A) x) =
      inclTensor A K x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul x a => rfl
  | add x y hx hy => simp only [map_add, hx, hy]

lemma range_inclTensor_mono {K L : IntermediateField k Ω} (h : K ≤ L) :
    Set.range (inclTensor A K) ⊆ Set.range (inclTensor A L) := by
  rintro _ ⟨x, rfl⟩
  exact ⟨_, inclTensor_comp_map_inclusion h x⟩

/-- Every element of `Ω ⊗[k] A` comes from `k(s) ⊗[k] A` for a finite set `s ⊆ Ω`. -/
lemma exists_finset_mem_range (x : Ω ⊗[k] A) :
    ∃ s : Finset Ω, x ∈ Set.range (inclTensor A (IntermediateField.adjoin k (s : Set Ω))) := by
  classical
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨∅, 0, map_zero _⟩
  | tmul ω a =>
    exact ⟨{ω}, ⟨ω, IntermediateField.subset_adjoin _ _ (by simp)⟩ ⊗ₜ a, rfl⟩
  | add x y hx hy =>
    obtain ⟨s, x', rfl⟩ := hx
    obtain ⟨t, y', rfl⟩ := hy
    obtain ⟨x'', hx''⟩ := range_inclTensor_mono (A := A)
      (IntermediateField.adjoin.mono k (s : Set Ω) ((s ∪ t : Finset Ω) : Set Ω) (by simp))
      ⟨x', rfl⟩
    obtain ⟨y'', hy''⟩ := range_inclTensor_mono (A := A)
      (IntermediateField.adjoin.mono k (t : Set Ω) ((s ∪ t : Finset Ω) : Set Ω) (by simp))
      ⟨y', rfl⟩
    exact ⟨s ∪ t, x'' + y'', by rw [map_add, hx'', hy'']⟩

/-- Every finite subset of `Ω ⊗[k] A` comes from `K ⊗[k] A` for a finite subextension `K`. -/
lemma exists_finiteDimensional_subset_range [Algebra.IsAlgebraic k Ω] (S : Set (Ω ⊗[k] A))
    (hS : S.Finite) :
    ∃ K : IntermediateField k Ω, FiniteDimensional k K ∧ S ⊆ Set.range (inclTensor A K) := by
  classical
  choose s hs using fun x : Ω ⊗[k] A ↦ exists_finset_mem_range (A := A) x
  let t : Finset Ω := hS.toFinset.biUnion s
  refine ⟨IntermediateField.adjoin k (t : Set Ω), ?_, fun x hx ↦ ?_⟩
  · exact IntermediateField.finiteDimensional_adjoin fun x _ ↦
      (Algebra.IsIntegral.isIntegral (R := k) x)
  · refine range_inclTensor_mono (IntermediateField.adjoin.mono _ _ _ ?_) (hs x)
    intro y hy
    simp only [Finset.coe_biUnion, Set.Finite.coe_toFinset, Set.mem_iUnion, t]
    exact ⟨x, hx, hy⟩

section FaithfullyFlat

variable (A) (K : IntermediateField k Ω)

/-- The `K ⊗[k] A`-algebra structure on `Ω ⊗[k] A` given by `inclTensor`. -/
abbrev algTensor : Algebra (K ⊗[k] A) (Ω ⊗[k] A) := (inclTensor A K).toRingHom.toAlgebra

/-- `(K ⊗[k] A) ⊗[K] Ω ≃ Ω ⊗[k] A`. -/
def tensorEquiv : (K ⊗[k] A) ⊗[K] Ω ≃ₐ[K] Ω ⊗[k] A :=
  (Algebra.TensorProduct.comm K (K ⊗[k] A) Ω).trans
    (Algebra.TensorProduct.cancelBaseChange k K K Ω A)

set_option backward.isDefEq.respectTransparency true in
lemma tensorEquiv_tmul_one (x : K ⊗[k] A) : tensorEquiv A K (x ⊗ₜ 1) = inclTensor A K x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul c a =>
    simp only [tensorEquiv, AlgEquiv.trans_apply, Algebra.TensorProduct.comm_tmul]
    erw [Algebra.TensorProduct.cancelBaseChange_tmul]
    simp [Algebra.smul_def]
  | add x y hx hy =>
    rw [TensorProduct.add_tmul, map_add, map_add, hx, hy]

set_option backward.isDefEq.respectTransparency true in
lemma tensorEquiv_smul (s : K ⊗[k] A) (m : (K ⊗[k] A) ⊗[K] Ω) :
    tensorEquiv A K (s • m) = inclTensor A K s * tensorEquiv A K m := by
  have h (y : K ⊗[k] A) (ω : Ω) :
      (y ⊗ₜ[K] ω : (K ⊗[k] A) ⊗[K] Ω) = (y ⊗ₜ 1) * (1 ⊗ₜ ω) := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  induction m using TensorProduct.induction_on with
  | zero => simp
  | tmul x ω =>
    rw [TensorProduct.smul_tmul', smul_eq_mul, h, h x, map_mul, map_mul,
      tensorEquiv_tmul_one, tensorEquiv_tmul_one, map_mul, mul_assoc]
  | add x y hx hy =>
    simp only [smul_add, map_add, hx, hy, mul_add]

/-- `tensorEquiv` is `K ⊗[k] A`-linear. -/
def tensorLinearEquiv :
    letI := algTensor A K
    ((K ⊗[k] A) ⊗[K] Ω) ≃ₗ[K ⊗[k] A] Ω ⊗[k] A :=
  letI := algTensor A K
  { toFun := tensorEquiv A K
    invFun := (tensorEquiv A K).symm
    map_add' := (tensorEquiv A K).map_add
    map_smul' := tensorEquiv_smul A K
    left_inv := (tensorEquiv A K).left_inv
    right_inv := (tensorEquiv A K).right_inv }

/-- `Ω ⊗[k] A` is faithfully flat over `K ⊗[k] A`. -/
lemma faithfullyFlat_tensor :
    letI := algTensor A K
    Module.FaithfullyFlat (K ⊗[k] A) (Ω ⊗[k] A) :=
  letI := algTensor A K
  Module.FaithfullyFlat.of_linearEquiv _ _ (tensorLinearEquiv A K).symm

end FaithfullyFlat

/-- **Finite étale algebras over `Ω ⊗[k] A` descend to a finite subextension.** For `Ω / k`
algebraic and `B` finite étale over `Ω ⊗[k] A` there are a finite subextension `K` and a finite
étale `K ⊗[k] A`-algebra `B'` with `B ≅ (Ω ⊗[k] A) ⊗[K ⊗[k] A] B'`. -/
theorem exists_descent_intermediateField [Algebra.IsAlgebraic k Ω] (B : Type u) [CommRing B]
    [Algebra (Ω ⊗[k] A) B] [Algebra.FiniteEtale (Ω ⊗[k] A) B] :
    ∃ (K : IntermediateField k Ω) (_ : FiniteDimensional k K) (B' : Type u) (_ : CommRing B')
      (_ : Algebra (K ⊗[k] A) B'), Algebra.FiniteEtale (K ⊗[k] A) B' ∧
      letI := algTensor A K
      Nonempty (B ≃ₐ[Ω ⊗[k] A] (Ω ⊗[k] A) ⊗[K ⊗[k] A] B') := by
  obtain ⟨A₀, B₀, _, _, ⟨s, hs⟩, _, ⟨e⟩⟩ :=
    Algebra.Etale.exists_subalgebra_fg (R := k) (A := Ω ⊗[k] A) (B := B)
  obtain ⟨K, hK, hsK⟩ := exists_finiteDimensional_subset_range (A := A) (s : Set (Ω ⊗[k] A))
    s.finite_toSet
  letI := algTensor A K
  let ι : K ⊗[k] A →ₐ[k] Ω ⊗[k] A := (inclTensor A K).restrictScalars k
  have hle : A₀ ≤ ι.range := by
    rw [← hs, Algebra.adjoin_le_iff]
    exact hsK
  let j : A₀ →ₐ[k] K ⊗[k] A :=
    (AlgEquiv.ofInjective ι (inclTensor_injective K)).symm.toAlgHom.comp
      (Subalgebra.inclusion hle)
  have hj (x : A₀) : inclTensor A K (j x) = x :=
    congr($((AlgEquiv.ofInjective ι (inclTensor_injective K)).apply_symm_apply
      (Subalgebra.inclusion hle x)))
  letI : Algebra A₀ (K ⊗[k] A) := j.toRingHom.toAlgebra
  haveI : IsScalarTower A₀ (K ⊗[k] A) (Ω ⊗[k] A) :=
    IsScalarTower.of_algebraMap_eq fun x ↦ (hj x).symm
  haveI := faithfullyFlat_tensor A K
  let e' : B ≃ₐ[Ω ⊗[k] A] (Ω ⊗[k] A) ⊗[K ⊗[k] A] ((K ⊗[k] A) ⊗[A₀] B₀) :=
    e.trans (Algebra.TensorProduct.cancelBaseChange A₀ (K ⊗[k] A) (Ω ⊗[k] A) (Ω ⊗[k] A)
      B₀).symm
  haveI : Module.Finite (Ω ⊗[k] A) ((Ω ⊗[k] A) ⊗[K ⊗[k] A] ((K ⊗[k] A) ⊗[A₀] B₀)) :=
    Module.Finite.equiv e'.toLinearEquiv
  haveI : Module.Finite (K ⊗[k] A) ((K ⊗[k] A) ⊗[A₀] B₀) :=
    .of_finite_tensorProduct_of_faithfullyFlat (Ω ⊗[k] A)
  exact ⟨K, hK, _, _, _, ⟨⟩, ⟨e'⟩⟩

end Algebra.FiniteEtale
