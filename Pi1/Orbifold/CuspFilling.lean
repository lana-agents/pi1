module

public import Pi1.Orbifold.EtaleTwoCharts

/-!
# Filling in cusps: `ker(π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(X))` is generated by inertia (Galois form)

Let `D : GaloisData k t` with `H = H_L`, `R` the integral closure of `k[t]` in `L = Ω^H`, and let
`t'` generate the same subfield `k(t') = k(t)`; `R'` is the integral closure of `k[t']` in `L`
(the ring of `D.transfer`). Let `ι : Y ⟶ Z` be a morphism with `Y ≅ Spec R'`, `Z ≅ Spec R`,
compatible with the generic points (e.g. `Y ⊆ Z` an open subscheme, `Z ∖ Y` a finite set of
closed points, and `t'` a function whose poles are exactly the points of `Z ∖ Y` and the poles
of `t`). Then (`GaloisData.ker_fundamentalGroupMap_eq_inertia`)

  `ker (π₁ᵉᵗ(Y) → π₁ᵉᵗ(Z)) = ⟨⟨images of the inertia elements of the places centred on Z but not
  on Y⟩⟩` (closed normal closure),

where the images are taken under the intrinsic Galois action `H ↠ π₁ᵉᵗ(Y)` through the generic
point (`GaloisData.chartHom`, surjective by `GaloisData.chartHom_surjective_of_iso_transfer`).
This is the "filling in cusps" input of [AbsTopI] Lemma 4.1 (v) (`Topics in Absolute Anabelian
Geometry I.txt`, l.2757–2767) for the elementary operations of type `•`, in Galois form:
the places centred on `Z` but not on `Y` are those over the removed points, and their inertia
groups are the cuspidal inertia groups.

## Main results

* `MonoidHom.ker_eq_topologicalClosure_normalClosure_image`: the group-theoretic core
  (for `f : H ↠ A` continuous from a compact group to a Hausdorff group,
  `ker (g ∘ f) = ⟨⟨T⟩⟩` implies `ker g = ⟨⟨f(T)⟩⟩`);
* `GaloisData.chartHom_surjective_of_iso_transfer`, `GaloisData.chartHom_eq_one_of_mem_Sat`;
* `GaloisData.ker_fundamentalGroupMap_eq_inertia`;
* `GaloisPi1.ker_pi1Map_eq`: the same statement in the Galois model `H ⧸ ⟨⟨S⟩⟩ ↠ H ⧸ ⟨⟨S'⟩⟩`.
-/

@[expose] public section

universe u

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale AffOrbicurve

/-- **Kernels through a surjection.** Let `f : H ↠ A` be a continuous surjective homomorphism from
a compact group onto a Hausdorff topological group and `g : A →* B`. If `ker (g ∘ f)` is the
closed normal subgroup generated by `T ⊆ H`, then `ker g` is the closed normal subgroup generated
by `f(T)`. -/
lemma MonoidHom.ker_eq_topologicalClosure_normalClosure_image {H A B : Type*} [Group H]
    [TopologicalSpace H] [IsTopologicalGroup H] [CompactSpace H] [Group A] [TopologicalSpace A]
    [IsTopologicalGroup A]
    [T2Space A] [Group B] (f : H →* A) (hf : Continuous f) (hs : Function.Surjective f)
    (g : A →* B) (T : Set H)
    (hker : (g.comp f).ker = (Subgroup.normalClosure T).topologicalClosure) :
    g.ker = (Subgroup.normalClosure (f '' T)).topologicalClosure := by
  have himage : (g.ker : Set A) = f '' ((g.comp f).ker : Set H) := by
    ext a
    obtain ⟨h, rfl⟩ := hs a
    constructor
    · intro ha
      exact ⟨h, ha, rfl⟩
    · rintro ⟨h', hh', he⟩
      rw [SetLike.mem_coe, MonoidHom.mem_ker, ← he]
      exact hh'
  have hclosed : IsClosed (g.ker : Set A) := by
    rw [himage, hker]
    exact ((Subgroup.isClosed_topologicalClosure _).isCompact.image hf).isClosed
  apply le_antisymm
  · intro a ha
    have ha' : a ∈ f '' ((g.comp f).ker : Set H) := himage ▸ ha
    rw [hker] at ha'
    obtain ⟨h, hh, rfl⟩ := ha'
    have h1 : f '' closure (Subgroup.normalClosure T : Set H) ⊆
        closure (f '' (Subgroup.normalClosure T : Set H)) :=
      image_closure_subset_closure_image hf
    have h2 : f '' (Subgroup.normalClosure T : Set H) =
        (Subgroup.normalClosure (f '' T) : Set A) := by
      rw [← Subgroup.map_normalClosure T f hs, Subgroup.coe_map]
    have hh' : h ∈ closure (Subgroup.normalClosure T : Set H) := by
      rwa [← Subgroup.topologicalClosure_coe]
    rw [← SetLike.mem_coe, Subgroup.topologicalClosure_coe, ← h2]
    exact h1 ⟨h, hh', rfl⟩
  · refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_) hclosed
    rintro _ ⟨s, hs', rfl⟩
    have : s ∈ (g.comp f).ker :=
      hker ▸ Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure hs')
    exact this

namespace GaloisPi1

variable {P Ω : Type u} [Field P] [Field Ω] [Algebra P Ω] [IsGalois P Ω]
  {H : Subgroup (Ω ≃ₐ[P] Ω)} {S S' : Set (Ω ≃ₐ[P] Ω)}

/-- **Filling in cusps in the Galois model.** For `S ⊆ S' ⊆ H` (inertia elements of the places
centred on `U ⊆ U'`), the kernel of `H ⧸ ⟨⟨S⟩⟩ ↠ H ⧸ ⟨⟨S'⟩⟩` is the closed normal subgroup
generated by the images of the inertia elements in `S' ∖ S` (the places over `U' ∖ U`). -/
theorem ker_pi1Map_eq (hHc : IsClosed (H : Set (Ω ≃ₐ[P] Ω))) (hS : S ⊆ S') (hS' : S' ⊆ H) :
    (pi1Map (S := S) (S' := S') hHc hHc le_rfl hS).ker =
      (Subgroup.normalClosure ((QuotientGroup.mk' (kernel H S) : H →* pi1 H S hHc) ''
        (Subtype.val ⁻¹' (S' \ S) : Set H))).topologicalClosure := by
  haveI := compactSpace_of_isClosed H hHc
  haveI : IsClosed (kernel H S : Set H) := isClosed_kernel H S
  have hker : ((pi1Map (S := S) (S' := S') hHc hHc le_rfl hS).comp
      (QuotientGroup.mk' (kernel H S) : H →* pi1 H S hHc)).ker =
      (Subgroup.normalClosure (Subtype.val ⁻¹' S' : Set H)).topologicalClosure := by
    rw [← kernel_eq_topologicalClosure H hHc S' hS']
    ext x
    simp only [MonoidHom.mem_ker, MonoidHom.comp_apply]
    change (QuotientGroup.mk (Subgroup.inclusion le_rfl x) : H ⧸ kernel H S') = 1 ↔ _
    rw [QuotientGroup.eq_one_iff]
    rfl
  rw [MonoidHom.ker_eq_topologicalClosure_normalClosure_image _ QuotientGroup.continuous_mk
    (QuotientGroup.mk'_surjective _) _ _ hker]
  congr 1
  apply le_antisymm
  · refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨σ, hσ, rfl⟩
    by_cases hσS : (σ : Ω ≃ₐ[P] Ω) ∈ S
    · have : (QuotientGroup.mk' (kernel H S) : H →* pi1 H S hHc) σ = 1 := by
        rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, kernel, Subgroup.mem_subgroupOf]
        exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ⟨1, H.one_mem, _, hσS,
          by simp⟩)
      rw [this]
      exact Subgroup.one_mem _
    · exact Subgroup.subset_normalClosure ⟨σ, ⟨hσ, hσS⟩, rfl⟩
  · exact Subgroup.normalClosure_mono (Set.image_mono fun σ hσ ↦ hσ.1)

end GaloisPi1

namespace Pi1.Orbifold

noncomputable section

namespace GaloisData

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t t' : Ω}
  [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] (D : GaloisData k t) (hH : D.H ≤ D.HL)
  [IsGalois (K₀ k t') Ω] (hK : ∀ x, x ∈ K₀ k t ↔ x ∈ K₀ k t') (ht' : Transcendental k t')
  [CharZero k]

include hH in
/-- The intrinsic Galois action `H → π₁ᵉᵗ(Y)` through a generic point is surjective when
`Y ≅ Spec R'` (the ring of `D.transfer`) compatibly with the generic points. -/
lemma chartHom_surjective_of_iso_transfer {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y)
    (j' : Spec (.of (D.transfer hK ht').L) ⟶ Y)
    (hξ : specPoint (D.transfer hK ht').L Ω ≫ j' = specPoint D.L Ω ≫ j)
    (e' : Y ≅ Spec (.of (D.transfer hK ht').R))
    (hj' : j' ≫ e'.hom = (D.transfer hK ht').genericPoint) :
    Function.Surjective (D.chartHom hH j) := by
  have h : (specPoint D.L Ω ≫ j) ≫ e'.hom = specPoint (D.transfer hK ht').R Ω := by
    rw [← hξ, Category.assoc, hj']
    exact (D.transfer hK ht').genericPoint_comp
  intro y
  obtain ⟨τ, hτ⟩ := (D.transfer hK ht').galoisHom_surjective (D.transfer_H_le hK ht' hH)
    (fundamentalGroupMap e'.hom h y)
  refine ⟨D.transferHomInv hK ht' τ, (fundamentalGroupMap_bijective_of_isIso _ h).1 ?_⟩
  rw [D.fundamentalGroupMap_chartHom_transfer hH hK ht' j e'.hom h, ← hτ]
  congr 1

include hH in
/-- The inertia elements of the places centred on `Spec R'` act trivially on `π₁ᵉᵗ(Y)`, for
`Y ≅ Spec R'` compatibly with the generic points. -/
lemma chartHom_eq_one_of_mem_Sat {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y)
    (j' : Spec (.of (D.transfer hK ht').L) ⟶ Y)
    (hξ : specPoint (D.transfer hK ht').L Ω ≫ j' = specPoint D.L Ω ≫ j)
    (e' : Y ≅ Spec (.of (D.transfer hK ht').R))
    (hj' : j' ≫ e'.hom = (D.transfer hK ht').genericPoint) (σ : D.H)
    (hσ : (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ D.Sat t') : D.chartHom hH j σ = 1 := by
  have h : (specPoint D.L Ω ≫ j) ≫ e'.hom = specPoint (D.transfer hK ht').R Ω := by
    rw [← hξ, Category.assoc, hj']
    exact (D.transfer hK ht').genericPoint_comp
  refine (fundamentalGroupMap_bijective_of_isIso _ h).1 ?_
  rw [D.fundamentalGroupMap_chartHom_transfer hH hK ht' j e'.hom h, map_one,
    ← MonoidHom.mem_ker, (D.transfer hK ht').ker_galoisHom (D.transfer_H_le hK ht' hH),
    GaloisPi1.kernel, Subgroup.mem_subgroupOf]
  refine Subgroup.le_topologicalClosure _
    (Subgroup.subset_closure ⟨1, Subgroup.one_mem _, galTransfer hK (σ : Ω ≃ₐ[K₀ k t] Ω), ?_,
      by simp⟩)
  rw [mem_transfer_S_iff hK D ht']
  exact hσ

include hH in
/-- **Filling in cusps, Galois form.** For `ι : Y ⟶ Z` with `Y ≅ Spec R'` and `Z ≅ Spec R`
compatibly with the generic points, the kernel of `π₁ᵉᵗ(Y) → π₁ᵉᵗ(Z)` is the closed normal
subgroup generated by the images under `H ↠ π₁ᵉᵗ(Y)` of the inertia elements of the places
centred on `Spec R` but not on `Spec R'` (the places over the points of `Z` missing from `Y`). -/
theorem ker_fundamentalGroupMap_eq_inertia {Y Z : Scheme.{u}} [ConnectedSpace Y] (ι : Y ⟶ Z)
    (j : Spec (.of D.L) ⟶ Y) (e : Z ≅ Spec (.of D.R)) (hj : j ≫ ι ≫ e.hom = D.genericPoint)
    (j' : Spec (.of (D.transfer hK ht').L) ⟶ Y)
    (hξ : specPoint (D.transfer hK ht').L Ω ≫ j' = specPoint D.L Ω ≫ j)
    (e' : Y ≅ Spec (.of (D.transfer hK ht').R))
    (hj' : j' ≫ e'.hom = (D.transfer hK ht').genericPoint) :
    (fundamentalGroupMap ι (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _)).toMonoidHom.ker =
      (Subgroup.normalClosure (D.chartHom hH j ''
        (Subtype.val ⁻¹' (D.S \ D.Sat t') : Set D.H))).topologicalClosure := by
  haveI := GaloisPi1.compactSpace_of_isClosed D.H D.isClosed_H
  have hS : D.S ⊆ D.H := fun _ h ↦ D.le h.1
  have hker := D.ker_chartHom_comp_iso hH j ι e hj
  rw [GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _ hS] at hker
  rw [MonoidHom.ker_eq_topologicalClosure_normalClosure_image _ (D.continuous_chartHom hH j)
    (D.chartHom_surjective_of_iso_transfer hH hK ht' j j' hξ e' hj') _ _ hker]
  congr 1
  apply le_antisymm
  · refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨σ, hσ, rfl⟩
    by_cases hσ' : (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ D.Sat t'
    · rw [D.chartHom_eq_one_of_mem_Sat hH hK ht' j j' hξ e' hj' σ hσ']
      exact Subgroup.one_mem _
    · exact Subgroup.subset_normalClosure ⟨σ, ⟨hσ, hσ'⟩, rfl⟩
  · exact Subgroup.normalClosure_mono (Set.image_mono fun σ hσ ↦ hσ.1)

end GaloisData

end

end Pi1.Orbifold
