module

public import Pi1.FundamentalGroup.TwoChartsKernel
public import Pi1.Orbifold.EtaleGalois

/-!
# `π₁ᵉᵗ` of a curve covered by two charts, as a Galois group

Let `D : GaloisData k t` with `H = H_L` (so `L = Ω^H`, `R` the integral closure of `k[t]` in
`L`), and let `t'` generate the same subfield `k(t') = k(t)` of `Ω` (in practice `t' = t⁻¹`).
Transporting `D` along `Gal(Ω / k(t)) = Gal(Ω / k(t'))` gives `D.transfer : GaloisData k t'`
with the same function field `L` (`GaloisData.mem_transfer_L`); its ring `R'` is the integral
closure of `k[t']` in `L`.

Let `X = U ∪ U'` be a scheme as in `FiniteEtale.ker_fundamentalGroupMap_eq` with `U ≅ Spec R`,
`U' ≅ Spec R'`, compatibly with generic points `Spec L ⟶ U ∩ U'`, such that
`π₁ᵉᵗ(Spec L) → π₁ᵉᵗ(U ∩ U')` is surjective (e.g. `U ∩ U' = Spec R[1/t]` with `R[1/t]` integrally
closed in `L`, `FiniteEtale.galoisAction_surjective`). Then the intrinsic Galois action
`H → π₁ᵉᵗ(X)` through the generic point (`GaloisData.chartHomX`) is surjective with kernel the
closed normal subgroup generated by the inertia elements of the places over `k[t]` and over
`k[t']` (`GaloisData.ker_chartHomX`), so

  `π₁ᵉᵗ(X) ≃ₜ* H ⧸ ⟨⟨S ∪ S'⟩⟩`

(`GaloisPi1.equivOfSurjective` applied to `GaloisData.chartHomX`, which is surjective by
`GaloisData.chartHomX_surjective` and continuous by `GaloisData.continuous_chartHomX`).

For `t' = t⁻¹` every place of `Ω` over `k` is centered on `k[t]` or on `k[t⁻¹]`, so `S ∪ S'` is
the set of all inertia elements (`GaloisData.S_union_Sat_inv`).

## Group-theoretic and topological input

* `Subgroup.topologicalClosure_normalClosure_union`: `⟨⟨⟨⟨A⟩⟩ ∪ ⟨⟨B⟩⟩⟩⟩ = ⟨⟨A ∪ B⟩⟩` for closed
  normal closures;
* `GaloisPi1.kernel_eq_topologicalClosure`: `GaloisPi1.kernel H S` is the closed normal closure of
  `S` in `H`;
* `continuous_of_isOpen_setOf_apply_eq`: a homomorphism into a Krull group is continuous if the
  stabilizers of points are open.
-/

@[expose] public section

universe u

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale AffOrbicurve

section Topology

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The closed normal subgroup generated by the closed normal closures of `A` and of `B` is the
closed normal closure of `A ∪ B`. -/
lemma Subgroup.topologicalClosure_normalClosure_union (A B : Set G) :
    (Subgroup.normalClosure (((Subgroup.normalClosure A).topologicalClosure : Set G) ∪
      (Subgroup.normalClosure B).topologicalClosure)).topologicalClosure =
      (Subgroup.normalClosure (A ∪ B)).topologicalClosure := by
  haveI : (Subgroup.normalClosure (A ∪ B)).topologicalClosure.Normal :=
    Subgroup.is_normal_topologicalClosure _
  have hMc := Subgroup.isClosed_topologicalClosure (Subgroup.normalClosure (A ∪ B))
  have hA : (Subgroup.normalClosure A).topologicalClosure ≤
      (Subgroup.normalClosure (A ∪ B)).topologicalClosure :=
    Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal fun a ha =>
      Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure (Or.inl ha))) hMc
  have hB : (Subgroup.normalClosure B).topologicalClosure ≤
      (Subgroup.normalClosure (A ∪ B)).topologicalClosure :=
    Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal fun a ha =>
      Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure (Or.inr ha))) hMc
  apply le_antisymm
  · refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_) hMc
    rintro x (hx | hx)
    exacts [hA hx, hB hx]
  · refine Subgroup.topologicalClosure_mono (Subgroup.normalClosure_mono ?_)
    rintro x (hx | hx)
    · exact Or.inl (Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure hx))
    · exact Or.inr (Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure hx))

/-- **Continuity into a Krull group**: a homomorphism `G → Gal(L / K)` is continuous if the
stabilizer of every element of `L` is open. -/
lemma continuous_of_isOpen_setOf_apply_eq {K L : Type*} [Field K] [Field L] [Algebra K L]
    (φ : G →* (L ≃ₐ[K] L)) (hφ : ∀ x : L, IsOpen {g | φ g x = x}) : Continuous φ := by
  refine continuous_of_continuousAt_one φ ?_
  intro A hA
  rw [map_one, krullTopology_mem_nhds_one_iff] at hA
  obtain ⟨E, hE, hEA⟩ := hA
  haveI := hE
  let b := Module.Free.chooseBasis K E
  refine Filter.mem_map.2 (Filter.mem_of_superset
    ((isOpen_iInter_of_finite fun i => hφ (b i : L)).mem_nhds ?_) ?_)
  · simp
  · intro g hg
    apply hEA
    rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    simp only [Set.mem_iInter, Set.mem_setOf_eq] at hg
    have hlin : (φ g).toLinearMap ∘ₗ E.val.toLinearMap = E.val.toLinearMap :=
      b.ext fun i => hg i
    exact LinearMap.congr_fun hlin ⟨x, hx⟩

end Topology

namespace GaloisPi1

variable {P Ω : Type u} [Field P] [Field Ω] [Algebra P Ω]

/-- `GaloisPi1.kernel H S` is the closed normal subgroup of `H` generated by `S` (for `H` closed
and `S ⊆ H`). -/
lemma kernel_eq_topologicalClosure (H : Subgroup (Ω ≃ₐ[P] Ω))
    (hH : IsClosed (H : Set (Ω ≃ₐ[P] Ω))) (S : Set (Ω ≃ₐ[P] Ω)) (hS : S ⊆ H) :
    kernel H S = (Subgroup.normalClosure (Subtype.val ⁻¹' S : Set ↥H)).topologicalClosure := by
  apply le_antisymm
  · intro x hx
    rw [kernel, Subgroup.mem_subgroupOf] at hx
    have hMc : IsClosed ((Subgroup.map H.subtype
        (Subgroup.normalClosure (Subtype.val ⁻¹' S : Set ↥H)).topologicalClosure :
          Subgroup _) : Set (Ω ≃ₐ[P] Ω)) := by
      rw [Subgroup.coe_map]
      have hcl := Subgroup.isClosed_topologicalClosure
        (Subgroup.normalClosure (Subtype.val ⁻¹' S : Set ↥H))
      exact hH.isClosedEmbedding_subtypeVal.isClosedMap _ hcl
    have hle : ambientKernel H S ≤
        (Subgroup.normalClosure (Subtype.val ⁻¹' S : Set ↥H)).topologicalClosure.map H.subtype := by
      refine Subgroup.topologicalClosure_minimal _ ?_ hMc
      rw [Subgroup.closure_le]
      rintro _ ⟨h, hh, s, hs, rfl⟩
      refine ⟨⟨h, hh⟩ * ⟨s, hS hs⟩ * ⟨h, hh⟩⁻¹, Subgroup.le_topologicalClosure _ ?_, rfl⟩
      exact (Subgroup.normalClosure_normal (s := (Subtype.val ⁻¹' S : Set ↥H))).conj_mem _
        (Subgroup.subset_normalClosure (show (⟨s, hS hs⟩ : H) ∈ Subtype.val ⁻¹' S from hs)) _
    obtain ⟨y, hy, hyx⟩ := hle hx
    rwa [Subtype.ext hyx] at hy
  · refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_)
      (isClosed_kernel H S)
    intro s hs
    rw [SetLike.mem_coe, kernel, Subgroup.mem_subgroupOf]
    exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ⟨1, H.one_mem, s, hs, by simp⟩)

/-- **A Galois group modulo inertia as a quotient of `H`**: a continuous surjection `φ` from a
closed subgroup `H` onto a Hausdorff topological group `G` with kernel `⟨⟨S⟩⟩` induces
`G ≃ₜ* H ⧸ ⟨⟨S⟩⟩` (`equivOfSurjective_symm_mk`). -/
noncomputable def equivOfSurjective [IsGalois P Ω] (H : Subgroup (Ω ≃ₐ[P] Ω))
    (hH : IsClosed (H : Set (Ω ≃ₐ[P] Ω))) (S : Set (Ω ≃ₐ[P] Ω)) {G : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [T2Space G] (φ : H →* G) (hφ : Continuous φ)
    (hs : Function.Surjective φ) (hker : φ.ker = kernel H S) : G ≃ₜ* pi1 H S hH :=
  haveI := compactSpace_of_isClosed H hH
  haveI : CompactSpace (H ⧸ kernel H S) := Quotient.compactSpace
  let e : (H ⧸ kernel H S) ≃* G :=
    (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective φ hs)
  have hc : Continuous e := (QuotientGroup.isQuotientMap_mk _).continuous_iff.2 hφ
  let e' : (H ⧸ kernel H S) ≃ₜ* G :=
    { e with
      continuous_toFun := hc
      continuous_invFun := hc.continuous_symm_of_equiv_compact_to_t2 (f := e.toEquiv) }
  e'.symm

lemma equivOfSurjective_symm_mk [IsGalois P Ω] (H : Subgroup (Ω ≃ₐ[P] Ω))
    (hH : IsClosed (H : Set (Ω ≃ₐ[P] Ω))) (S : Set (Ω ≃ₐ[P] Ω)) {G : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [T2Space G] (φ : H →* G) (hφ : Continuous φ)
    (hs : Function.Surjective φ) (hker : φ.ker = kernel H S) (σ : H) :
    (equivOfSurjective H hH S φ hφ hs hker).symm (σ : H ⧸ kernel H S) = φ σ :=
  rfl

end GaloisPi1

namespace Pi1.Orbifold

noncomputable section

namespace GaloisData

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t t' : Ω}

section Transfer

variable (hK : ∀ x, x ∈ K₀ k t ↔ x ∈ K₀ k t')

/-- **`Gal(Ω / k(t)) = Gal(Ω / k(t'))`** for `k(t) = k(t')`. -/
def galTransfer : (Ω ≃ₐ[K₀ k t] Ω) ≃* (Ω ≃ₐ[K₀ k t'] Ω) where
  toFun σ := AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) fun x => by
    simpa using σ.commutes ⟨x, (hK x).2 x.2⟩
  invFun σ := AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) fun x => by
    simpa using σ.commutes ⟨x, (hK x).1 x.2⟩
  left_inv σ := by ext x; simp
  right_inv σ := by ext x; simp
  map_mul' σ τ := by ext x; simp

@[simp] lemma galTransfer_apply (σ : Ω ≃ₐ[K₀ k t] Ω) (x : Ω) : galTransfer hK σ x = σ x := by
  simp [galTransfer]

@[simp] lemma galTransfer_symm_apply (σ : Ω ≃ₐ[K₀ k t'] Ω) (x : Ω) :
    (galTransfer hK).symm σ x = σ x := by
  simp [galTransfer]

lemma continuous_galTransfer [IsGalois (K₀ k t) Ω] : Continuous (galTransfer hK) :=
  continuous_of_isOpen_setOf_apply_eq (galTransfer hK).toMonoidHom fun x => by
    simp only [MulEquiv.coe_toMonoidHom, galTransfer_apply]
    exact isOpen_setOf_apply_eq (t := t) x

lemma continuous_galTransfer_symm [IsGalois (K₀ k t') Ω] : Continuous (galTransfer hK).symm :=
  continuous_of_isOpen_setOf_apply_eq (galTransfer hK).symm.toMonoidHom fun x => by
    simp only [MulEquiv.coe_toMonoidHom, galTransfer_symm_apply]
    exact isOpen_setOf_apply_eq (t := t') x

variable [IsGalois (K₀ k t') Ω] (D : GaloisData k t) (ht' : Transcendental k t')

/-- **The Galois data `D` seen from `t'`**, for `k(t') = k(t)`: the same groups `H_L ≤ H`, as
subgroups of `Gal(Ω / k(t'))`. Its function field is `L` (`mem_transfer_L`) and its ring is the
integral closure of `k[t']` in `L`. -/
def transfer : GaloisData k t' where
  H := D.H.map (galTransfer hK).toMonoidHom
  HL := D.HL.map (galTransfer hK).toMonoidHom
  le := Subgroup.map_mono D.le
  isOpen_HL := by
    have : ((D.HL.map (galTransfer hK).toMonoidHom : Subgroup _) : Set (Ω ≃ₐ[K₀ k t'] Ω)) =
        (galTransfer hK).symm ⁻¹' D.HL := by
      ext σ
      exact Subgroup.mem_map_equiv
    rw [this]
    exact D.isOpen_HL.preimage (continuous_galTransfer_symm hK)
  conj_mem := by
    rintro _ ⟨h, hh, rfl⟩ _ ⟨n, hn, rfl⟩
    exact ⟨h * n * h⁻¹, D.conj_mem h hh n hn, by simp⟩
  transcendental := ht'

lemma mem_transfer_HL_iff (σ : Ω ≃ₐ[K₀ k t] Ω) :
    galTransfer hK σ ∈ (D.transfer hK ht').HL ↔ σ ∈ D.HL := by
  change _ ∈ D.HL.map (galTransfer hK).toMonoidHom ↔ _
  rw [Subgroup.mem_map_equiv, MulEquiv.symm_apply_apply]

lemma transfer_H_le (hH : D.H ≤ D.HL) : (D.transfer hK ht').H ≤ (D.transfer hK ht').HL :=
  Subgroup.map_mono hH

/-- The function field of `D.transfer` is the function field of `D`. -/
lemma mem_transfer_L (x : Ω) : x ∈ (D.transfer hK ht').L ↔ x ∈ D.L := by
  simp only [L, IntermediateField.mem_fixedField_iff]
  constructor
  · intro h g hg
    exact h _ ((mem_transfer_HL_iff hK D ht' g).2 hg)
  · intro h f hf
    have := h _ ((mem_transfer_HL_iff hK D ht' _).1
      (by rwa [MulEquiv.apply_symm_apply] : galTransfer hK ((galTransfer hK).symm f) ∈ _))
    exact this

/-- The isomorphism `H → H'` of the groups of `D` and of `D.transfer`. -/
def transferHom : D.H →* (D.transfer hK ht').H :=
  (galTransfer hK).toMonoidHom.subgroupMap D.H

@[simp] lemma coe_transferHom (σ : D.H) :
    (D.transferHom hK ht' σ : Ω ≃ₐ[K₀ k t'] Ω) = galTransfer hK σ := rfl

/-- The inverse of `transferHom`. -/
def transferHomInv : (D.transfer hK ht').H →* D.H where
  toFun σ := ⟨(galTransfer hK).symm σ, Subgroup.mem_map_equiv.1 σ.2⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' _ _ := Subtype.ext (map_mul _ _ _)

@[simp] lemma transferHomInv_transferHom (σ : D.H) :
    D.transferHomInv hK ht' (D.transferHom hK ht' σ) = σ :=
  Subtype.ext ((galTransfer hK).symm_apply_apply σ)

lemma continuous_transferHom [IsGalois (K₀ k t) Ω] : Continuous (D.transferHom hK ht') :=
  ((continuous_galTransfer hK).comp continuous_subtype_val).subtype_mk _

lemma continuous_transferHomInv : Continuous (D.transferHomInv hK ht') :=
  ((continuous_galTransfer_symm hK).comp continuous_subtype_val).subtype_mk _

/-- The inertia elements at the places containing `u`. -/
def Sat (u : Ω) : Set (Ω ≃ₐ[K₀ k t] Ω) :=
  {σ | σ ∈ D.HL ∧ ∃ W : ValuationSubring Ω, (∀ c : k, algebraMap k Ω c ∈ W) ∧ u ∈ W ∧
    σ ∈ GaloisPi1.inertia W}

lemma S_eq_Sat : D.S = D.Sat t := rfl

lemma Sat_subset_H (u : Ω) : D.Sat u ⊆ D.H := fun _ h => D.le h.1

lemma mem_transfer_S_iff (σ : Ω ≃ₐ[K₀ k t] Ω) :
    galTransfer hK σ ∈ (D.transfer hK ht').S ↔ σ ∈ D.Sat t' := by
  change (galTransfer hK σ ∈ (D.transfer hK ht').HL ∧ _) ↔ (σ ∈ D.HL ∧ _)
  rw [mem_transfer_HL_iff]
  simp only [GaloisPi1.inertia, Set.mem_setOf_eq, galTransfer_apply]

end Transfer

/-- For `t' = t⁻¹`, the inertia elements over `k[t]` and over `k[t⁻¹]` are all inertia
elements of places over `k`. -/
lemma S_union_Sat_inv (D : GaloisData k t) :
    D.S ∪ D.Sat t⁻¹ = {σ | σ ∈ D.HL ∧ ∃ W : ValuationSubring Ω,
      (∀ c : k, algebraMap k Ω c ∈ W) ∧ σ ∈ GaloisPi1.inertia W} := by
  ext σ
  constructor
  · rintro (⟨hσ, W, hk, -, hW⟩ | ⟨hσ, W, hk, -, hW⟩)
    exacts [⟨hσ, W, hk, hW⟩, ⟨hσ, W, hk, hW⟩]
  · rintro ⟨hσ, W, hk, hW⟩
    rcases W.mem_or_inv_mem t with ht | ht
    exacts [Or.inl ⟨hσ, W, hk, ht, hW⟩, Or.inr ⟨hσ, W, hk, ht, hW⟩]

lemma mem_K₀_inv_iff (x : Ω) : x ∈ K₀ k t ↔ x ∈ K₀ k t⁻¹ := by
  have h1 : K₀ k t⁻¹ ≤ K₀ k t := IntermediateField.adjoin_le_iff.2
    (Set.singleton_subset_iff.2 (inv_mem (IntermediateField.mem_adjoin_simple_self k t)))
  have h2 : K₀ k t ≤ K₀ k t⁻¹ := IntermediateField.adjoin_le_iff.2
    (Set.singleton_subset_iff.2 (by
      simpa using inv_mem (IntermediateField.mem_adjoin_simple_self k t⁻¹)))
  exact ⟨fun h => h2 h, fun h => h1 h⟩

lemma continuous_toGalL [IsGalois (K₀ k t) Ω] (D : GaloisData k t) : Continuous D.toGalL :=
  continuous_of_isOpen_setOf_apply_eq D.toGalL fun x =>
    (isOpen_setOf_apply_eq (t := t) x).preimage continuous_subtype_val

section TwoCharts

variable [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] (D : GaloisData k t) (hH : D.H ≤ D.HL)

/-- **The intrinsic Galois action of `H` on `π₁ᵉᵗ(Y)`** through a point `j : Spec L ⟶ Y`. -/
def chartHom {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) : D.H →* π₁ᵉᵗ(specPoint D.L Ω ≫ j) :=
  (galoisAction D.L j rfl).comp (D.toGalL.comp (Subgroup.inclusion hH))

lemma chartHom_apply {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) (σ : D.H) :
    D.chartHom hH j σ = galoisAction D.L j rfl (D.toGalL (Subgroup.inclusion hH σ)) := rfl

lemma continuous_chartHom {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) :
    Continuous (D.chartHom hH j) :=
  (continuous_galoisAction D.L j rfl).comp
    (D.continuous_toGalL.comp (continuous_subtype_val.subtype_mk _))

lemma chartHom_surjective {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y)
    (hj : Function.Surjective (fundamentalGroupMap j (rfl : specPoint D.L Ω ≫ j = _))) :
    Function.Surjective (D.chartHom hH j) := by
  intro γ
  obtain ⟨a, rfl⟩ := hj γ
  obtain ⟨g, rfl⟩ := (mulEquivAutFiber D.L Ω).surjective a
  obtain ⟨σ, rfl⟩ := D.toGalL_surjective g
  exact ⟨⟨σ, D.le σ.2⟩, rfl⟩

variable {X : Scheme.{u}} (U U' : X.Opens)

/-- **The intrinsic Galois action of `H` on `π₁ᵉᵗ(X)`** for `X = U ∪ U'`, through a point
`j : Spec L ⟶ U ∩ U'`. -/
def chartHomX (j : Spec (.of D.L) ⟶ (U ⊓ U' : X.Opens)) :
    D.H →* π₁ᵉᵗ(((specPoint D.L Ω ≫ j) ≫ incl₁ U U') ≫ U.ι) :=
  (fundamentalGroupMap U.ι (rfl : ((specPoint D.L Ω ≫ j) ≫ incl₁ U U') ≫ U.ι = _)).toMonoidHom.comp
    ((fundamentalGroupMap (incl₁ U U')
      (rfl : (specPoint D.L Ω ≫ j) ≫ incl₁ U U' = _)).toMonoidHom.comp (D.chartHom hH j))

lemma chartHomX_apply (j : Spec (.of D.L) ⟶ (U ⊓ U' : X.Opens)) (σ : D.H) :
    D.chartHomX hH U U' j σ = fundamentalGroupMap U.ι
      (rfl : ((specPoint D.L Ω ≫ j) ≫ incl₁ U U') ≫ U.ι = _) (fundamentalGroupMap (incl₁ U U')
        (rfl : (specPoint D.L Ω ≫ j) ≫ incl₁ U U' = _) (D.chartHom hH j σ)) := rfl

lemma continuous_chartHomX (j : Spec (.of D.L) ⟶ (U ⊓ U' : X.Opens)) :
    Continuous (D.chartHomX hH U U' j) :=
  (fundamentalGroupMap U.ι _).continuous.comp
    ((fundamentalGroupMap (incl₁ U U') _).continuous.comp (D.continuous_chartHom hH j))

/-- `chartHom` followed by a morphism to `Spec R` compatible with the generic point is the
intrinsic Galois action on `π₁ᵉᵗ(Spec R)`. -/
lemma fundamentalGroupMap_chartHom {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y)
    (φ : Y ⟶ Spec (.of D.R)) (hφ : j ≫ φ = D.genericPoint)
    (h : (specPoint D.L Ω ≫ j) ≫ φ = specPoint D.R Ω) (σ : D.H) :
    fundamentalGroupMap φ h (D.chartHom hH j σ) = D.galoisHom hH σ := by
  rw [chartHom_apply, fundamentalGroupMap_galoisAction D.L j φ rfl h
      (by rw [hφ]; exact D.genericPoint_comp),
    galoisHom_apply, galoisHomL_eq]
  exact DFunLike.congr_fun (galoisAction_congr D.L hφ _ _) _

lemma fundamentalGroupMap_iso_chartHom {Y Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) (ι : Y ⟶ Z)
    (e : Z ≅ Spec (.of D.R)) (hj : j ≫ ι ≫ e.hom = D.genericPoint)
    (h : ((specPoint D.L Ω ≫ j) ≫ ι) ≫ e.hom = specPoint D.R Ω) (σ : D.H) :
    fundamentalGroupMap e.hom h (fundamentalGroupMap ι
      (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _) (D.chartHom hH j σ)) = D.galoisHom hH σ := by
  have h' : (specPoint D.L Ω ≫ j) ≫ ι ≫ e.hom = specPoint D.R Ω := by
    rw [← Category.assoc]
    exact h
  exact (DFunLike.congr_fun (fundamentalGroupMap_comp ι e.hom rfl h h') _).symm.trans
    (D.fundamentalGroupMap_chartHom hH j (ι ≫ e.hom) hj h' σ)

variable [CharZero k]

lemma ker_chartHom_comp_iso {Y Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) (ι : Y ⟶ Z)
    (e : Z ≅ Spec (.of D.R)) (hj : j ≫ ι ≫ e.hom = D.genericPoint) :
    ((fundamentalGroupMap ι (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _)).toMonoidHom.comp
      (D.chartHom hH j)).ker = GaloisPi1.kernel D.H D.S := by
  have h : ((specPoint D.L Ω ≫ j) ≫ ι) ≫ e.hom = specPoint D.R Ω := by
    simp only [Category.assoc]
    rw [hj]
    exact D.genericPoint_comp
  rw [← MonoidHom.ker_comp_of_injective _ (fundamentalGroupMap e.hom h).toMonoidHom
    (fundamentalGroupMap_bijective_of_isIso _ h).1, ← D.ker_galoisHom hH]
  exact congrArg MonoidHom.ker (MonoidHom.ext (D.fundamentalGroupMap_iso_chartHom hH j ι e hj h))

lemma chartHom_comp_iso_surjective {Y Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) (ι : Y ⟶ Z)
    (e : Z ≅ Spec (.of D.R)) (hj : j ≫ ι ≫ e.hom = D.genericPoint) :
    Function.Surjective ((fundamentalGroupMap ι
      (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _)).toMonoidHom.comp (D.chartHom hH j)) := by
  have h : ((specPoint D.L Ω ≫ j) ≫ ι) ≫ e.hom = specPoint D.R Ω := by
    simp only [Category.assoc]
    rw [hj]
    exact D.genericPoint_comp
  intro y
  obtain ⟨σ, hσ⟩ := D.galoisHom_surjective hH (fundamentalGroupMap e.hom h y)
  exact ⟨σ, (fundamentalGroupMap_bijective_of_isIso _ h).1
    ((D.fundamentalGroupMap_iso_chartHom hH j ι e hj h σ).trans hσ)⟩

variable [IsGalois (K₀ k t') Ω] (hK : ∀ x, x ∈ K₀ k t ↔ x ∈ K₀ k t') (ht' : Transcendental k t')

omit [IsSepClosed Ω] [CharZero k] in
/-- The inertia elements over `k[t']`, seen in `H`: the preimage under `H ≅ H'` of the closed
normal closure of the inertia elements of `D.transfer` is the closed normal closure of
`D.Sat t'`. -/
lemma comap_kernel_transfer :
    (GaloisPi1.kernel (D.transfer hK ht').H (D.transfer hK ht').S).comap
      (D.transferHom hK ht') =
      (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure := by
  have hS' : (D.transfer hK ht').S ⊆ (D.transfer hK ht').H := fun _ h =>
    (D.transfer hK ht').le h.1
  rw [GaloisPi1.kernel_eq_topologicalClosure _ (D.transfer hK ht').isClosed_H _ hS']
  haveI hN :
      (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure.Normal :=
    Subgroup.is_normal_topologicalClosure _
  haveI hN' : (Subgroup.normalClosure (Subtype.val ⁻¹' (D.transfer hK ht').S :
      Set (D.transfer hK ht').H)).topologicalClosure.Normal :=
    Subgroup.is_normal_topologicalClosure _
  apply le_antisymm
  · intro σ hσ
    haveI := hN.comap (D.transferHomInv hK ht')
    have hle : (Subgroup.normalClosure (Subtype.val ⁻¹' (D.transfer hK ht').S :
          Set (D.transfer hK ht').H)).topologicalClosure ≤
        (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure.comap
          (D.transferHomInv hK ht') := by
      refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_)
        ((Subgroup.isClosed_topologicalClosure _).preimage (D.continuous_transferHomInv hK ht'))
      intro s hs
      refine Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure ?_)
      change ((galTransfer hK).symm (s : Ω ≃ₐ[K₀ k t'] Ω)) ∈ D.Sat t'
      rw [← mem_transfer_S_iff hK D ht', MulEquiv.apply_symm_apply]
      exact hs
    have := hle hσ
    rwa [Subgroup.mem_comap, transferHomInv_transferHom] at this
  · haveI := hN'.comap (D.transferHom hK ht')
    refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_)
      ((Subgroup.isClosed_topologicalClosure _).preimage (D.continuous_transferHom hK ht'))
    intro s hs
    refine Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure ?_)
    change galTransfer hK (s : Ω ≃ₐ[K₀ k t] Ω) ∈ (D.transfer hK ht').S
    rw [mem_transfer_S_iff hK D ht']
    exact hs

omit [CharZero k] in
lemma fundamentalGroupMap_chartHom_transfer {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y)
    (φ : Y ⟶ Spec (.of (D.transfer hK ht').R))
    (h : (specPoint D.L Ω ≫ j) ≫ φ = specPoint (D.transfer hK ht').R Ω) (σ : D.H) :
    fundamentalGroupMap φ h (D.chartHom hH j σ) =
      (D.transfer hK ht').galoisHom (D.transfer_H_le hK ht' hH) (D.transferHom hK ht' σ) := by
  rw [chartHom_apply, fundamentalGroupMap_galoisAction D.L j φ rfl h
      (by rw [← Category.assoc]; exact h),
    galoisHom_apply, galoisHomL_eq]
  refine galoisAction_eq_of_apply_eq D.L _ _ _ _ _ _ fun x => ?_
  simp only [toGalL_apply, Subgroup.coe_inclusion, coe_transferHom, galTransfer_apply]

lemma ker_chartHom_comp_iso_transfer {Y Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y)
    (j' : Spec (.of (D.transfer hK ht').L) ⟶ Y)
    (hξ : specPoint (D.transfer hK ht').L Ω ≫ j' = specPoint D.L Ω ≫ j) (ι : Y ⟶ Z)
    (e : Z ≅ Spec (.of (D.transfer hK ht').R))
    (hj' : j' ≫ ι ≫ e.hom = (D.transfer hK ht').genericPoint) :
    ((fundamentalGroupMap ι (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _)).toMonoidHom.comp
      (D.chartHom hH j)).ker =
      (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure := by
  have h : ((specPoint D.L Ω ≫ j) ≫ ι) ≫ e.hom = specPoint (D.transfer hK ht').R Ω := by
    rw [← hξ]
    simp only [Category.assoc]
    rw [hj']
    exact (D.transfer hK ht').genericPoint_comp
  have h' : (specPoint D.L Ω ≫ j) ≫ ι ≫ e.hom = specPoint (D.transfer hK ht').R Ω := by
    rw [← Category.assoc]
    exact h
  have hσ (σ : D.H) : fundamentalGroupMap e.hom h (fundamentalGroupMap ι
      (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _) (D.chartHom hH j σ)) =
      (D.transfer hK ht').galoisHom (D.transfer_H_le hK ht' hH) (D.transferHom hK ht' σ) :=
    (DFunLike.congr_fun (fundamentalGroupMap_comp ι e.hom rfl h h') _).symm.trans
      (D.fundamentalGroupMap_chartHom_transfer hH hK ht' j (ι ≫ e.hom) h' σ)
  rw [← MonoidHom.ker_comp_of_injective _ (fundamentalGroupMap e.hom h).toMonoidHom
    (fundamentalGroupMap_bijective_of_isIso _ h).1, ← D.comap_kernel_transfer hK ht',
    ← (D.transfer hK ht').ker_galoisHom (D.transfer_H_le hK ht' hH), MonoidHom.comap_ker]
  exact congrArg MonoidHom.ker (MonoidHom.ext hσ)


/-- **Étale van Kampen for two charts, Galois form.** Let `X = U ∪ U'` (with the hypotheses of
`FiniteEtale.ker_fundamentalGroupMap_eq`), `U ≅ Spec R`, `U' ≅ Spec R'` (`R'` the ring of
`D.transfer`), and `j : Spec L ⟶ U ∩ U'`, `j' : Spec L ⟶ U ∩ U'` compatible with the generic
points of `Spec R` and `Spec R'` and inducing the same geometric point, such that
`π₁ᵉᵗ(Spec L) → π₁ᵉᵗ(U ∩ U')` is surjective. Then the kernel of the intrinsic Galois action
`H → π₁ᵉᵗ(X)` is the closed normal subgroup generated by the inertia elements over `k[t]` and
over `k[t']`. -/
theorem ker_chartHomX (hUU' : U ⊔ U' = ⊤) [ConnectedSpace X]
    [ConnectedSpace U] [ConnectedSpace U'] [ConnectedSpace (U ⊓ U' : X.Opens)]
    [QuasiCompact U.ι] [QuasiCompact (incl₂ U U')] [IsIso U.ι.fromNormalization]
    [IsIso (incl₂ U U').fromNormalization] [IsReduced X] [IsLocallyNoetherian X]
    (eU : (U : Scheme) ≅ Spec (.of D.R)) (eU' : (U' : Scheme) ≅ Spec (.of (D.transfer hK ht').R))
    (j : Spec (.of D.L) ⟶ (U ⊓ U' : X.Opens))
    (j' : Spec (.of (D.transfer hK ht').L) ⟶ (U ⊓ U' : X.Opens))
    (hj : j ≫ incl₁ U U' ≫ eU.hom = D.genericPoint)
    (hj' : j' ≫ incl₂ U U' ≫ eU'.hom = (D.transfer hK ht').genericPoint)
    (hξ : specPoint (D.transfer hK ht').L Ω ≫ j' = specPoint D.L Ω ≫ j)
    (hsurj : Function.Surjective (fundamentalGroupMap j (rfl : specPoint D.L Ω ≫ j = _))) :
    (D.chartHomX hH U U' j).ker = GaloisPi1.kernel D.H (D.S ∪ D.Sat t') := by
  have hsub : D.S ∪ D.Sat t' ⊆ D.H := Set.union_subset (D.Sat_subset_H t) (D.Sat_subset_H t')
  rw [chartHomX, ker_comp_fundamentalGroupMap_eq U U' hUU' (specPoint D.L Ω ≫ j)
      (D.chartHom hH j) (D.continuous_chartHom hH j) (D.chartHom_surjective hH j hsurj)
      (D.chartHom_comp_iso_surjective hH j (incl₁ U U') eU hj),
    D.ker_chartHom_comp_iso hH j (incl₁ U U') eU hj,
    D.ker_chartHom_comp_iso_transfer hH hK ht' j j' hξ (incl₂ U U') eU' hj',
    GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _ hsub,
    GaloisPi1.kernel_eq_topologicalClosure (S := D.S) _ D.isClosed_H (D.Sat_subset_H t),
    Set.preimage_union]
  exact Subgroup.topologicalClosure_normalClosure_union _ _

omit [IsGalois (K₀ k t') Ω] in
theorem chartHomX_surjective [ConnectedSpace X] [ConnectedSpace U]
    [ConnectedSpace (U ⊓ U' : X.Opens)] [QuasiCompact U.ι] [IsIso U.ι.fromNormalization]
    (eU : (U : Scheme) ≅ Spec (.of D.R)) (j : Spec (.of D.L) ⟶ (U ⊓ U' : X.Opens))
    (hj : j ≫ incl₁ U U' ≫ eU.hom = D.genericPoint) :
    Function.Surjective (D.chartHomX hH U U' j) := by
  intro y
  obtain ⟨z, rfl⟩ := fundamentalGroupMap_surjective_of_isIso_fromNormalization U.ι
    (rfl : ((specPoint D.L Ω ≫ j) ≫ incl₁ U U') ≫ U.ι = _) y
  obtain ⟨σ, rfl⟩ := D.chartHom_comp_iso_surjective hH j (incl₁ U U') eU hj z
  exact ⟨σ, rfl⟩

