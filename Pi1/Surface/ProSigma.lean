module

public import Pi1.Profinite.ProSigma
public import Pi1.Surface.CuspOrder

/-!
# Pro-`Σ` surface groups and elevation at a vertex

For a set of primes `Σ` (a predicate `P`), `Π^Σ_{g,r} = SurfaceGroup.proSigma P g r` is the
pro-`Σ` completion of the surface group, with cusp inertia homomorphisms
`SurfaceGroup.cuspInertiaSigma P j : ℤ^Σ → Π^Σ_{g,r}` (`ℤ^Σ` the pro-`Σ` completion of `ℤ`).

* `ProSigmaCompletion.map` (functoriality), `map_eta`, `continuous_map`, `liftFinite_map`,
  `ProSigmaCompletion.exists_eta_liftFinite_eq` (every value of an extension is attained on `Γ`),
  `ProSigmaCompletion.isOpen_liftFinite_fiber`;
* **`SurfaceGroup.exists_elevated_proSigma`**: for `n > 0` with prime divisors in `Σ` and
  hyperbolic `(g, r)`, a continuous surjection `ρ : Π^Σ_{g,r} ↠ Q` onto a finite group of
  `Σ`-integer order under which every cusp generator has order exactly `n³` (so all cusp inertia
  groups have the same kernel `n³ ℤ^Σ`: the quotients glue along the edges, a `π₁`-epimorphic
  approximator), with a subgroup `N ≤ Q` of order `≥ n` meeting every conjugate of every image
  `ρ(I_j)` of a cusp inertia group trivially: the vertex is **elevated** in the sense of
  [SemiAnbd] Def 2.4(i) (the pro-`Σ` form of [SemiAnbd] Ex 2.10, for every hyperbolic `(g, r)`,
  including genus `0`; from `SurfaceGroup.exists_elevated_quotient_of_primes`).
-/

@[expose] public section

open ProfiniteGrp ProfiniteGrp.ProfiniteCompletion CategoryTheory
open scoped Pointwise

universe u

namespace Pi1.Profinite

namespace ProSigmaCompletion

variable {P : ℕ → Prop} {Γ Γ' : Type u} [Group Γ] [Group Γ']

/-- The pro-`Σ` completion is pro-`Σ`. -/
theorem isSigmaNat_index (M : Subgroup (ProSigmaCompletion P Γ))
    (hM : IsOpen (M : Set (ProSigmaCompletion P Γ))) :
    IsSigmaNat P M.index :=
  MaxProSigma.isSigmaNat_index_maxProSigma M hM

/-- **Functoriality** of the pro-`Σ` completion. -/
noncomputable def map (φ : Γ →* Γ') : ProSigmaCompletion P Γ →* ProSigmaCompletion P Γ' :=
  MaxProSigma.lift (fun M hM _ ↦ isSigmaNat_index M hM)
    ((MaxProSigma.mk (P := P)).comp (completionMap φ))
    (MaxProSigma.continuous_mk.comp (continuous_completionMap φ))

theorem continuous_map (φ : Γ →* Γ') : Continuous (map (P := P) φ) :=
  MaxProSigma.continuous_lift _ _ _

@[simp]
theorem map_eta (φ : Γ →* Γ') (x : Γ) : map (P := P) φ (eta P x) = eta P (φ x) := by
  change MaxProSigma.mk (completionMap φ (etaFn (GrpCat.of Γ) x)) = _
  rw [completionMap_eta]
  rfl

/-- The fibres of `liftFinite f` are open. -/
theorem isOpen_liftFinite_fiber {Q : Type u} [Group Q] [Finite Q] (f : Γ →* Q)
    (hQ : IsSigmaNat P (Nat.card Q)) (q : Q) : IsOpen {x | liftFinite f hQ x = q} := by
  letI : TopologicalSpace Q := ⊥
  haveI : DiscreteTopology Q := ⟨rfl⟩
  exact (isOpen_discrete {q}).preimage (MaxProSigma.continuous_liftFinite _ _ _)

/-- Every value of `liftFinite f` on an open set is attained on the image of `Γ`. -/
theorem exists_eta_mem_of_isOpen {U : Set (ProSigmaCompletion P Γ)} (hU : IsOpen U)
    {x : ProSigmaCompletion P Γ} (hx : x ∈ U) : ∃ w : Γ, eta P w ∈ U := by
  obtain ⟨_, hy, w, rfl⟩ := (denseRange_eta (P := P) (Γ := Γ)).inter_open_nonempty U hU ⟨x, hx⟩
  exact ⟨w, hy⟩

theorem liftFinite_map {Q : Type u} [Group Q] [Finite Q] (φ : Γ →* Γ') (ρ : Γ' →* Q)
    (hQ : IsSigmaNat P (Nat.card Q)) (x : ProSigmaCompletion P Γ) :
    liftFinite ρ hQ (map φ x) = liftFinite (ρ.comp φ) hQ x := by
  have hU : IsOpen {y | liftFinite ρ hQ (map φ y) = liftFinite ρ hQ (map φ x) ∧
      liftFinite (ρ.comp φ) hQ y = liftFinite (ρ.comp φ) hQ x} :=
    ((isOpen_liftFinite_fiber ρ hQ _).preimage (continuous_map φ)).inter
      (isOpen_liftFinite_fiber _ hQ _)
  obtain ⟨w, hw1, hw2⟩ := exists_eta_mem_of_isOpen hU ⟨rfl, rfl⟩
  rw [← hw1, ← hw2, map_eta, liftFinite_eta, liftFinite_eta, MonoidHom.comp_apply]

end ProSigmaCompletion

end Pi1.Profinite

namespace Pi1.SurfaceGroup

open Pi1.Profinite

variable (P : ℕ → Prop) {g r : ℕ}

variable (g r) in
/-- **The pro-`Σ` surface group** `Π^Σ_{g,r}`. -/
noncomputable abbrev proSigma : Type := ProSigmaCompletion P (SurfaceGroup g r)

/-- **The cusp inertia** `ℤ^Σ → Π^Σ_{g,r}` of the `j`-th cusp. -/
noncomputable def cuspInertiaSigma (j : Fin r) :
    ProSigmaCompletion P (Multiplicative ℤ) →* proSigma P g r :=
  ProSigmaCompletion.map (zpowersHom _ (cusp j))

variable {P}

/-- The image of the cusp inertia under an extension of `ρ : Π_{g,r} → Q` is generated by the
image of the cusp generator. -/
theorem range_liftFinite_comp_cuspInertiaSigma {Q : Type} [Group Q] [Finite Q]
    (ρ : SurfaceGroup g r →* Q) (hQ : IsSigmaNat P (Nat.card Q)) (j : Fin r) :
    ((ProSigmaCompletion.liftFinite ρ hQ).comp (cuspInertiaSigma P j)).range =
      Subgroup.zpowers (ρ (cusp j)) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    rw [MonoidHom.comp_apply, cuspInertiaSigma, ProSigmaCompletion.liftFinite_map]
    obtain ⟨w, hw⟩ := ProSigmaCompletion.exists_eta_mem_of_isOpen
      (ProSigmaCompletion.isOpen_liftFinite_fiber (ρ.comp (zpowersHom _ (cusp j))) hQ
        (ProSigmaCompletion.liftFinite (ρ.comp (zpowersHom _ (cusp j))) hQ x)) rfl
    rw [← hw, ProSigmaCompletion.liftFinite_eta, MonoidHom.comp_apply, zpowersHom_apply,
      map_zpow]
    exact Subgroup.zpow_mem_zpowers _ _
  · rw [Subgroup.zpowers_le]
    refine ⟨ProSigmaCompletion.eta P (Multiplicative.ofAdd 1), ?_⟩
    rw [MonoidHom.comp_apply, cuspInertiaSigma, ProSigmaCompletion.map_eta,
      ProSigmaCompletion.liftFinite_eta, zpowersHom_apply, toAdd_ofAdd, zpow_one]

/-- **Elevation at a vertex, pro-`Σ` form** ([SemiAnbd] Def 2.4(i), Ex 2.10): for `n > 0` with
prime divisors in `Σ` and hyperbolic `(g, r)`, there is a continuous (open fibres) surjection
`ρ : Π^Σ_{g,r} ↠ Q` onto a finite group of `Σ`-integer order such that every cusp generator has
order exactly `n³`, the image of every cusp inertia group is generated by its cusp generator, and
some `N ≤ Q` of order `≥ n` meets every conjugate of every image of a cusp inertia group
trivially. -/
theorem exists_elevated_proSigma {n : ℕ} (hn : 0 < n) (hS : ∀ p, p.Prime → p ∣ n → P p)
    (h : IsHyperbolic g r) :
    ∃ (Q : Type) (_ : Group Q) (_ : Finite Q) (_ : IsSigmaNat P (Nat.card Q))
      (ρ : proSigma P g r →* Q) (N : Subgroup Q),
      (∀ q, IsOpen {x | ρ x = q}) ∧ Function.Surjective ρ ∧
        (∀ j, orderOf (ρ (ProSigmaCompletion.eta P (cusp j))) = n ^ 3) ∧
        (∀ j, (ρ.comp (cuspInertiaSigma P j)).range =
          Subgroup.zpowers (ρ (ProSigmaCompletion.eta P (cusp j)))) ∧
        n ≤ Nat.card N ∧
        ∀ j (q : Q), N ⊓ (ConjAct.toConjAct q • (ρ.comp (cuspInertiaSigma P j)).range) = ⊥ := by
  obtain ⟨Q, iG, iF, ρ, N, hs, hp, hc, hN, hconj⟩ :=
    exists_elevated_quotient_of_primes (S := {p | P p}) hn hS h
  have hQ : IsSigmaNat P (Nat.card Q) := ⟨Nat.card_pos.ne', hp⟩
  refine ⟨Q, iG, iF, hQ, ProSigmaCompletion.liftFinite ρ hQ, N,
    ProSigmaCompletion.isOpen_liftFinite_fiber ρ hQ, fun q ↦ ?_, fun j ↦ ?_, fun j ↦ ?_, hN,
    fun j q ↦ ?_⟩
  · obtain ⟨x, rfl⟩ := hs q
    exact ⟨ProSigmaCompletion.eta P x, ProSigmaCompletion.liftFinite_eta ρ hQ x⟩
  · rw [ProSigmaCompletion.liftFinite_eta]
    exact hc j
  · rw [range_liftFinite_comp_cuspInertiaSigma, ProSigmaCompletion.liftFinite_eta]
  · rw [range_liftFinite_comp_cuspInertiaSigma]
    exact hconj j q

end Pi1.SurfaceGroup
