/-!
# Profinite surface groups

`Π̂_{g,r}` (`Pi1.ProfiniteSurfaceGroup g r`) is the profinite completion of the surface group
`Π_{g,r}` (`Pi1.SurfaceGroup`). In characteristic `0` it is the geometric étale fundamental group
of a hyperbolic curve of type `(g, r)` (comparison theorem and Riemann existence). We prove the
group-theoretic properties of `Π̂_{g,r}` used in anabelian geometry, for `r ≥ 1`:

* `Pi1.SurfaceGroup.profiniteFreeEquiv`: `Π̂_{g,r+1}` is the free profinite group on
  `2g + r` generators;
* `Pi1.SurfaceGroup.isSlim`: for `(g, r)` hyperbolic and `r ≥ 1`, `Π̂_{g,r}` is **slim** (every
  open subgroup has trivial centraliser), in particular centre-free
  (`Pi1.SurfaceGroup.center_eq_bot`);
* `Pi1.SurfaceGroup.cuspInertia j : ℤ̂ →* Π̂_{g,r}`, `k ↦ cⱼ ^ k`, is injective
  (`cuspInertia_injective`, for `r ≥ 2` or `g ≥ 1`), its image is the closed subgroup
  `Iⱼ = ⟨cⱼ⟩‾` generated by the `j`-th cuspidal generator (`range_cuspInertia`), and
  `cuspInertiaEquiv : ℤ̂ ≃ₜ* Iⱼ`: **the cuspidal inertia groups are isomorphic to `ℤ̂`**.

Injectivity of `cuspInertia` is proved by exhibiting, for every `n ≥ 1`, a finite quotient of
`Π_{g,r}` in which `cⱼ` has order exactly `n`: `ℤ/n` with `cⱼ ↦ 1`, `c_{j'} ↦ -1` if `r ≥ 2`,
and the Heisenberg group `(ℤ/n)² ⋊ ℤ/n` (as permutations of `(ℤ/n)²`) with `[a₁, b₁]` of order
`n` if `r = 1`, `g ≥ 1`.
-/

@[expose] public section

open CategoryTheory ProfiniteGrp ProfiniteGrp.ProfiniteCompletion Topology

namespace Pi1

open Profinite SurfaceGen

/-- The profinite surface group `Π̂_{g,r}`. -/
noncomputable abbrev ProfiniteSurfaceGroup (g r : ℕ) : ProfiniteGrp.{0} :=
  completion (GrpCat.of (SurfaceGroup g r))

/-- `ℤ̂`, the profinite completion of `ℤ` (written multiplicatively). -/
noncomputable abbrev ZHat : ProfiniteGrp.{0} := completion (GrpCat.of (Multiplicative ℤ))

namespace SurfaceGroup

variable {g r : ℕ}

/-! ### `Π̂_{g,r+1}` is free profinite -/

/-- `Π̂_{g,r+1} ≃ F̂(a₁, b₁, …, a_g, b_g, c₁, …, c_r)`. -/
noncomputable def profiniteFreeEquiv :
    ProfiniteSurfaceGroup g (r + 1) ≃ₜ* FreeHat (SurfaceGen g r) :=
  completionCongr freeEquiv

/-- **`Π̂_{g,r}` is slim** for `(g, r)` hyperbolic with `r ≥ 1`. -/
theorem isSlim (hr : 0 < r) (h : IsHyperbolic g r) : IsSlim (ProfiniteSurfaceGroup g r) := by
  obtain ⟨r, rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by omega⟩
  refine IsSlim.of_continuousMulEquiv profiniteFreeEquiv.symm ?_
  rcases Nat.eq_zero_or_pos g with rfl | hg
  · have hr2 : 1 < r := by unfold IsHyperbolic at h; omega
    exact isSlim_completion_freeGroup (a := SurfaceGen.c ⟨0, by omega⟩)
      (b := SurfaceGen.c ⟨1, hr2⟩) (by simp)
  · exact isSlim_completion_freeGroup (a := SurfaceGen.a ⟨0, hg⟩) (b := SurfaceGen.b ⟨0, hg⟩)
      (by simp)

/-- **`Π̂_{g,r}` is centre-free** for `(g, r)` hyperbolic with `r ≥ 1`. -/
theorem center_eq_bot (hr : 0 < r) (h : IsHyperbolic g r) :
    Subgroup.center (ProfiniteSurfaceGroup g r) = ⊥ :=
  (isSlim hr h).center_eq_bot

/-! ### Finite quotients with cuspidal generators of prescribed order -/

section Quotients

variable (n : ℕ)

/-- For `r ≥ 2`: a homomorphism `Π_{g,r} → ℤ/n` with `cⱼ ↦ 1`. -/
theorem exists_orderOf_cusp_of_two_le [NeZero n] (hr : 1 < r) (j : Fin r) :
    ∃ ρ : SurfaceGroup g r →* Multiplicative (ZMod n), orderOf (ρ (cusp j)) = n := by
  obtain ⟨j', hj'⟩ : ∃ j' : Fin r, j' ≠ j := by
    by_cases h0 : j.val = 0
    · exact ⟨⟨1, hr⟩, fun h ↦ by simp [Fin.ext_iff, h0] at h⟩
    · exact ⟨⟨0, by omega⟩, fun h ↦ h0 (by simp [← h])⟩
  let e : Fin r → ZMod n := Pi.single j 1 - Pi.single j' 1
  refine ⟨lift (fun _ ↦ 1) (fun _ ↦ 1) (fun k ↦ Multiplicative.ofAdd (e k)) ?_, ?_⟩
  · simp only [commProd, ordProd, mul_one, inv_one, List.prod_ofFn, Finset.prod_const_one,
      one_mul]
    rw [← ofAdd_sum]
    simp [e, Finset.sum_sub_distrib]
  · rw [lift_cusp]
    simp only [e, Pi.sub_apply, Pi.single_eq_same, Pi.single_eq_of_ne' hj', sub_zero]
    rw [orderOf_ofAdd_eq_addOrderOf, ZMod.addOrderOf_one]

/-- The permutation `(u, v) ↦ (u + 1, v)` of `(ℤ/n)²`. -/
def heisX : Equiv.Perm (ZMod n × ZMod n) where
  toFun p := (p.1 + 1, p.2)
  invFun p := (p.1 - 1, p.2)
  left_inv p := by simp
  right_inv p := by simp

/-- The permutation `(u, v) ↦ (u, v + u)` of `(ℤ/n)²`. -/
def heisY : Equiv.Perm (ZMod n × ZMod n) where
  toFun p := (p.1, p.2 + p.1)
  invFun p := (p.1, p.2 - p.1)
  left_inv p := by simp
  right_inv p := by simp

/-- The permutation `(u, v) ↦ (u, v - 1)` of `(ℤ/n)²`. -/
def heisT : Equiv.Perm (ZMod n × ZMod n) where
  toFun p := (p.1, p.2 - 1)
  invFun p := (p.1, p.2 + 1)
  left_inv p := by simp
  right_inv p := by simp

lemma heis_comm : heisX n * heisY n * (heisX n)⁻¹ * (heisY n)⁻¹ = heisT n := by
  rw [mul_inv_eq_iff_eq_mul, mul_inv_eq_iff_eq_mul]
  ext p
  · simp [heisX, heisY, heisT, Equiv.Perm.mul_apply]
  · simp only [heisX, heisY, heisT, Equiv.Perm.mul_apply, Equiv.coe_fn_mk]
    ring

lemma heisT_pow (m : ℕ) (p : ZMod n × ZMod n) : (heisT n ^ m) p = (p.1, p.2 - m) := by
  induction m generalizing p with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, Equiv.Perm.mul_apply, ih]
    simp only [heisT, Equiv.coe_fn_mk, Nat.cast_succ]
    ext <;> simp; ring

lemma orderOf_heisT [NeZero n] : orderOf (heisT n) = n := by
  have hn : 0 < n := Nat.pos_of_ne_zero (NeZero.ne n)
  rw [orderOf_eq_iff hn]
  refine ⟨?_, fun m hm hm0 h ↦ ?_⟩
  · ext p <;> simp [heisT_pow]
  · have := congrArg Prod.snd (Equiv.ext_iff.1 h (0, 0))
    simp only [heisT_pow, zero_sub, Equiv.Perm.coe_one, id_eq, neg_eq_zero] at this
    rw [ZMod.natCast_eq_zero_iff] at this
    exact absurd (Nat.le_of_dvd hm0 this) (not_le.2 hm)

/-- For `r = 1`, `g ≥ 1`: a homomorphism from `Π_{g,1}` to the Heisenberg group mod `n` under
which the cuspidal generator `c₀ = (∏ᵢ [aᵢ, bᵢ])⁻¹` has order `n`. -/
theorem exists_orderOf_cusp_of_genus_pos [NeZero n] (hg : 0 < g) (j : Fin 1) :
    ∃ ρ : SurfaceGroup g 1 →* Equiv.Perm (ZMod n × ZMod n), orderOf (ρ (cusp j)) = n := by
  obtain ⟨g, rfl⟩ : ∃ g', g = g' + 1 := ⟨g - 1, by omega⟩
  let x : Fin (g + 1) → Equiv.Perm (ZMod n × ZMod n) := Fin.cases (heisX n) fun _ ↦ 1
  let y : Fin (g + 1) → Equiv.Perm (ZMod n × ZMod n) := Fin.cases (heisY n) fun _ ↦ 1
  have hxy : commProd x y = heisT n := by
    simp [commProd, List.ofFn_succ, x, y, ← heis_comm, mul_assoc]
  refine ⟨lift x y (fun _ ↦ (commProd x y)⁻¹) ?_, ?_⟩
  · simp [ordProd]
  · rw [lift_cusp, orderOf_inv, hxy, orderOf_heisT]

end Quotients

/-! ### Cuspidal inertia -/

/-- **The cuspidal inertia map** `ℤ̂ → Π̂_{g,r}`, `k ↦ cⱼ ^ k`. -/
noncomputable def cuspInertia (j : Fin r) : ZHat →* ProfiniteSurfaceGroup g r :=
  completionMap (zpowersHom _ (cusp j))

theorem continuous_cuspInertia (j : Fin r) : Continuous (cuspInertia (g := g) j) :=
  continuous_completionMap _

/-- **The cuspidal inertia map is injective** (for `r ≥ 2` or `g ≥ 1`; in particular for every
hyperbolic `(g, r)` with `r ≥ 1`). -/
theorem cuspInertia_injective (hr : 1 < r ∨ 0 < g) (j : Fin r) :
    Function.Injective (cuspInertia (g := g) j) := by
  refine completionMap_zpowersHom_injective fun n hn ↦ ?_
  haveI : NeZero n := ⟨hn.ne'⟩
  rcases lt_or_ge 1 r with hr2 | hr2
  · obtain ⟨ρ, hρ⟩ := exists_orderOf_cusp_of_two_le (g := g) n hr2 j
    exact ⟨_, _, inferInstanceAs (Finite (ZMod n)), ρ, hρ⟩
  · have hg := hr.resolve_left (not_lt.2 hr2)
    obtain rfl : r = 1 := by have := j.pos; omega
    obtain ⟨ρ, hρ⟩ := exists_orderOf_cusp_of_genus_pos n hg j
    exact ⟨_, _, inferInstance, ρ, hρ⟩

/-- The **cuspidal inertia group** `Iⱼ = ⟨cⱼ⟩‾ ⊆ Π̂_{g,r}`, the closed subgroup topologically
generated by the `j`-th cuspidal generator. -/
noncomputable def inertia (j : Fin r) : Subgroup (ProfiniteSurfaceGroup g r) :=
  (Subgroup.zpowers (etaFn (GrpCat.of (SurfaceGroup g r)) (cusp j))).topologicalClosure

theorem range_cuspInertia (j : Fin r) : (cuspInertia (g := g) j).range = inertia j := by
  have hc := continuous_cuspInertia (g := g) j
  have hcl : IsClosed ((cuspInertia (g := g) j).range : Set (ProfiniteSurfaceGroup g r)) := by
    rw [MonoidHom.coe_range]
    exact (isCompact_range hc).isClosed
  have hsub : Subgroup.zpowers (etaFn (GrpCat.of (SurfaceGroup g r)) (cusp j)) ≤
      (cuspInertia j).range := by
    rw [Subgroup.zpowers_le]
    refine ⟨etaFn (GrpCat.of (Multiplicative ℤ)) (Multiplicative.ofAdd (1 : ℤ)), ?_⟩
    rw [cuspInertia, completionMap_eta, zpowersHom_apply]
    change etaFn (GrpCat.of (SurfaceGroup g r)) (cusp j ^ (1 : ℤ)) = _
    rw [zpow_one]
  refine le_antisymm ?_ (Subgroup.topologicalClosure_minimal _ hsub hcl)
  rintro _ ⟨x, rfl⟩
  have hx : x ∈ closure (Set.range (etaFn (GrpCat.of (Multiplicative ℤ)))) := by
    rw [(denseRange _).closure_range]
    trivial
  have := map_mem_closure hc hx
    (t := ((Subgroup.zpowers (etaFn (GrpCat.of (SurfaceGroup g r)) (cusp j)) :
      Subgroup (ProfiniteSurfaceGroup g r)) : Set (ProfiniteSurfaceGroup g r)))
    (by
      rintro _ ⟨k, rfl⟩
      simp only [cuspInertia, completionMap_eta, zpowersHom_apply]
      exact Subgroup.mem_zpowers_iff.2
        ⟨_, (map_zpow (eta (GrpCat.of (SurfaceGroup g r))).hom _ _).symm⟩)
  exact this

/-- **The cuspidal inertia groups are isomorphic to `ℤ̂`**: `ℤ̂ ≃ₜ* Iⱼ` (for `r ≥ 2` or `g ≥ 1`;
in particular for every hyperbolic `(g, r)` with `r ≥ 1`). -/
noncomputable def cuspInertiaEquiv (hr : 1 < r ∨ 0 < g) (j : Fin r) :
    ZHat ≃ₜ* inertia (g := g) j :=
  let e : ZHat ≃* inertia (g := g) j :=
    (MonoidHom.ofInjective (cuspInertia_injective hr j)).trans
      (MulEquiv.subgroupCongr (range_cuspInertia j))
  have hc : Continuous e := (continuous_cuspInertia j).subtype_mk _
  let h := hc.homeoOfEquivCompactToT2 (f := e.toEquiv)
  { e with
    continuous_toFun := h.continuous
    continuous_invFun := h.symm.continuous }

theorem cuspInertiaEquiv_apply (hr : 1 < r ∨ 0 < g) (j : Fin r) (x : ZHat) :
    (cuspInertiaEquiv hr j x : ProfiniteSurfaceGroup g r) = cuspInertia j x := rfl

end SurfaceGroup

end Pi1
