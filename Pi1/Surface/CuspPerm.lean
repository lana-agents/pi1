module

public import Pi1.Surface.SurfaceMoves
public import Mathlib.GroupTheory.Perm.Sign
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.Logic.Equiv.Fin.Basic

/-!
# Permuting and filling cusps of surface groups

* `Pi1.SurfaceGroup.exists_mulEquiv_isConj_cusp`: every permutation `π` of the cusps of
  `Π_{g,r}` is realised up to conjugacy by an automorphism (`θ (cⱼ) ∼ c_{π j}`). The adjacent
  transpositions generate the symmetric group as a monoid (`Equiv.Perm.mclosure_swap_castSucc_succ`)
  and are realised by the Hurwitz moves (`SurfaceGroup.hurwitzEquiv`).
* `Pi1.SurfaceGroup.lastCuspsEquiv`: `Π_{g,r+m} ⧸ ⟨⟨c_r, …, c_{r+m-1}⟩⟩ ≃* Π_{g,r}` (filling in
  the last `m` punctures), cusps `cⱼ ↦ cⱼ` for `j < r`.
* `Pi1.SurfaceGroup.exists_quotient_normalClosure_cusp_mulEquiv`: filling in an arbitrary set of
  punctures: `Π_{g,R} ⧸ ⟨⟨cⱼ | ¬ p j⟩⟩ ≃* Π_{g,r}`, `r = #{j | p j}`, the surviving cusps going
  to conjugates of the cusps of `Π_{g,r}`.
-/

@[expose] public section

namespace Pi1.SurfaceGroup

open SurfaceGen Equiv

variable {g : ℕ}

/-- **Permuting cusps**: every permutation of the cusps is realised, up to conjugacy of the
images of the cusps, by an automorphism of `Π_{g,r}`. -/
theorem exists_mulEquiv_isConj_cusp {r : ℕ} (π : Perm (Fin r)) :
    ∃ θ : SurfaceGroup g r ≃* SurfaceGroup g r, ∀ k, IsConj (θ (cusp k)) (cusp (π k)) := by
  cases r with
  | zero => exact ⟨MulEquiv.refl _, fun k ↦ k.elim0⟩
  | succ r =>
    let S : Submonoid (Perm (Fin (r + 1))) :=
      { carrier := {π | ∃ θ : SurfaceGroup g (r + 1) ≃* SurfaceGroup g (r + 1),
          ∀ k, IsConj (θ (cusp k)) (cusp (π k))}
        one_mem' := ⟨MulEquiv.refl _, fun _ ↦ IsConj.refl _⟩
        mul_mem' := by
          rintro π₁ π₂ ⟨θ₁, h₁⟩ ⟨θ₂, h₂⟩
          exact ⟨θ₂.trans θ₁, fun k ↦ (isConj_map θ₁ (h₂ k)).trans (h₁ (π₂ k))⟩ }
    have hS : Submonoid.closure (Set.range fun i : Fin r ↦ swap i.castSucc i.succ) ≤ S := by
      rw [Submonoid.closure_le]
      rintro _ ⟨j, rfl⟩
      exact ⟨hurwitzEquiv j, isConj_hurwitzEquiv_cusp j⟩
    rw [Perm.mclosure_swap_castSucc_succ] at hS
    exact hS (Submonoid.mem_top π)

/-- Re-indexing the cusps along a bijection `Fin r ≃ Fin r'`, up to conjugacy. -/
theorem exists_mulEquiv_isConj_cusp' {r r' : ℕ} (e : Fin r ≃ Fin r') :
    ∃ θ : SurfaceGroup g r ≃* SurfaceGroup g r', ∀ k, IsConj (θ (cusp k)) (cusp (e k)) := by
  obtain rfl : r = r' := by simpa using Fintype.card_congr e
  exact exists_mulEquiv_isConj_cusp e

lemma ordProd_add {G : Type*} [Group G] {r m : ℕ} (z : Fin (r + m) → G) :
    ordProd z = ordProd (fun i : Fin r ↦ z (Fin.castAdd m i)) *
      ordProd (fun j : Fin m ↦ z (Fin.natAdd r j)) := by
  rw [ordProd, ordProd, ordProd, List.ofFn_add, List.prod_append]
  rfl

@[simp] lemma ordProd_one {G : Type*} [Group G] {r : ℕ} :
    ordProd (fun _ : Fin r ↦ (1 : G)) = 1 := by
  simp [ordProd]

/-- Two normal closures agree if every generator of each is conjugate to a generator of the
other. -/
lemma normalClosure_eq_of_isConj {G : Type*} [Group G] {S S' : Set G}
    (h : ∀ s ∈ S, ∃ s' ∈ S', IsConj s s') (h' : ∀ s' ∈ S', ∃ s ∈ S, IsConj s' s) :
    Subgroup.normalClosure S = Subgroup.normalClosure S' := by
  have key : ∀ {T T' : Set G}, (∀ s ∈ T, ∃ s' ∈ T', IsConj s s') →
      Subgroup.normalClosure T ≤ Subgroup.normalClosure T' := by
    intro T T' hT
    refine Subgroup.normalClosure_le_normal fun s hs ↦ ?_
    obtain ⟨s', hs', hc⟩ := hT s hs
    obtain ⟨c, rfl⟩ := isConj_iff.1 hc.symm
    exact (Subgroup.normalClosure_normal).conj_mem _ (Subgroup.subset_normalClosure hs') c
  exact le_antisymm (key h) (key h')

section last

variable (g) (r m : ℕ)

/-- The normal subgroup of `Π_{g,r+m}` generated by the last `m` cusps. -/
def lastCusps : Subgroup (SurfaceGroup g (r + m)) :=
  Subgroup.normalClosure (Set.range fun j : Fin m ↦ cusp (Fin.natAdd r j))

instance : (lastCusps g r m).Normal := Subgroup.normalClosure_normal

variable {g r m}

/-- Killing the last `m` cusps. -/
def killFwd : SurfaceGroup g (r + m) →* SurfaceGroup g r :=
  lift genA genB (Fin.addCases cusp fun _ ↦ 1) (by
    rw [ordProd_add]
    simp only [Fin.addCases_left, Fin.addCases_right, ordProd_one, mul_one]
    exact relation)

lemma lastCusps_le_ker : lastCusps g r m ≤ (killFwd (g := g) (r := r) (m := m)).ker := by
  refine Subgroup.normalClosure_le_normal ?_
  rintro _ ⟨j, rfl⟩
  simp [killFwd]

/-- The inverse of filling in the last `m` cusps. -/
def killBwd : SurfaceGroup g r →* SurfaceGroup g (r + m) ⧸ lastCusps g r m :=
  lift (fun i ↦ QuotientGroup.mk (genA i)) (fun i ↦ QuotientGroup.mk (genB i))
    (fun k ↦ QuotientGroup.mk (cusp (Fin.castAdd m k))) (by
      have h1 : ordProd (fun j : Fin m ↦
          QuotientGroup.mk' (lastCusps g r m) (cusp (g := g) (Fin.natAdd r j))) = 1 := by
        have : (fun j : Fin m ↦
            QuotientGroup.mk' (lastCusps g r m) (cusp (g := g) (Fin.natAdd r j))) = fun _ ↦ 1 := by
          funext j
          exact (QuotientGroup.eq_one_iff _).2 (Subgroup.subset_normalClosure ⟨j, rfl⟩)
        rw [this, ordProd_one]
      have h := congrArg (QuotientGroup.mk' (lastCusps g r m)) (relation (g := g) (r := r + m))
      rw [ordProd_add, ← mul_assoc, map_mul, map_mul, map_commProd, map_ordProd, map_ordProd,
        map_one, h1, mul_one] at h
      exact h)

/-- **Filling in the last `m` punctures**: `Π_{g,r+m} ⧸ ⟨⟨c_r, …, c_{r+m-1}⟩⟩ ≃* Π_{g,r}`. -/
def lastCuspsEquiv : SurfaceGroup g (r + m) ⧸ lastCusps g r m ≃* SurfaceGroup g r :=
  MonoidHom.toMulEquiv (QuotientGroup.lift _ killFwd lastCusps_le_ker) killBwd
    (QuotientGroup.monoidHom_ext _ (hom_ext (fun i ↦ by simp [killFwd, killBwd])
      (fun i ↦ by simp [killFwd, killBwd]) fun k ↦ by
        refine Fin.addCases (fun k ↦ ?_) (fun j ↦ ?_) k
        · simp [killFwd, killBwd]
        · simp only [MonoidHom.coe_comp, Function.comp_apply, QuotientGroup.mk'_apply,
            QuotientGroup.lift_mk, killFwd, lift_cusp, Fin.addCases_right, map_one,
            MonoidHom.id_apply]
          rw [eq_comm, QuotientGroup.eq_one_iff]
          exact Subgroup.subset_normalClosure ⟨j, rfl⟩))
    (hom_ext (fun i ↦ by simp [killFwd, killBwd]) (fun i ↦ by simp [killFwd, killBwd])
      fun k ↦ by simp [killFwd, killBwd])

@[simp] lemma lastCuspsEquiv_mk_cusp (k : Fin r) :
    lastCuspsEquiv (g := g) (m := m) (QuotientGroup.mk (cusp (Fin.castAdd m k))) = cusp k := by
  simp [lastCuspsEquiv, killFwd]

end last

/-- **Filling in punctures**: killing the cusps `cⱼ` with `¬ p j` gives a surface group with one
puncture for each `j` with `p j`, the surviving cusps going to conjugates of its cusps. -/
theorem exists_quotient_normalClosure_cusp_mulEquiv {R : ℕ} (p : Fin R → Prop)
    [DecidablePred p] :
    ∃ (Θ : SurfaceGroup g R ⧸ Subgroup.normalClosure {x | ∃ j, ¬ p j ∧ cusp j = x} ≃*
        SurfaceGroup g (Fintype.card {j // p j})) (μ : {j // p j} ≃ Fin (Fintype.card {j // p j})),
      ∀ j : {j // p j}, IsConj (Θ (QuotientGroup.mk (cusp j.1))) (cusp (μ j)) := by
  set r := Fintype.card {j // p j}
  set m := Fintype.card {j // ¬ p j}
  let μ := Fintype.equivFin {j // p j}
  let μ' := Fintype.equivFin {j // ¬ p j}
  let e : Fin (r + m) ≃ Fin R :=
    finSumFinEquiv.symm.trans ((μ.symm.sumCongr μ'.symm).trans (Equiv.sumCompl p))
  have he₁ (k : Fin r) : e (Fin.castAdd m k) = (μ.symm k).1 := by
    simp only [e, Equiv.trans_apply, finSumFinEquiv_symm_apply_castAdd]; rfl
  have he₂ (j : Fin m) : e (Fin.natAdd r j) = (μ'.symm j).1 := by
    simp only [e, Equiv.trans_apply, finSumFinEquiv_symm_apply_natAdd]; rfl
  obtain ⟨θ, hθ⟩ := exists_mulEquiv_isConj_cusp' (g := g) e
  -- `θ⁻¹ (c_{e k}) ∼ c_k`
  have hθ' (k : Fin (r + m)) : IsConj (θ.symm (cusp (e k))) (cusp k) := by
    have := isConj_map θ.symm (hθ k)
    rw [MulEquiv.symm_apply_apply] at this
    exact this.symm
  set N := Subgroup.normalClosure {x | ∃ j, ¬ p j ∧ cusp (g := g) j = x}
  have hN : N.map θ.symm.toMonoidHom = lastCusps g r m := by
    rw [Subgroup.map_normalClosure _ _ θ.symm.surjective, lastCusps]
    refine normalClosure_eq_of_isConj ?_ ?_
    · rintro _ ⟨_, ⟨j, hj, rfl⟩, rfl⟩
      refine ⟨_, ⟨μ' ⟨j, hj⟩, rfl⟩, ?_⟩
      have := hθ' (Fin.natAdd r (μ' ⟨j, hj⟩))
      rwa [he₂, Equiv.symm_apply_apply] at this
    · rintro _ ⟨j, rfl⟩
      refine ⟨_, ⟨cusp (μ'.symm j).1, ⟨_, (μ'.symm j).2, rfl⟩, rfl⟩, ?_⟩
      have := hθ' (Fin.natAdd r j)
      rw [he₂] at this
      exact this.symm
  refine ⟨(QuotientGroup.congr N (lastCusps g r m) θ.symm hN).trans lastCuspsEquiv, μ, ?_⟩
  intro j
  rw [MulEquiv.trans_apply, QuotientGroup.congr_mk]
  have h1 := hθ' (Fin.castAdd m (μ j))
  rw [he₁, Equiv.symm_apply_apply] at h1
  have h2 := isConj_map (lastCuspsEquiv (g := g) (r := r) (m := m))
    (isConj_map (QuotientGroup.mk' (lastCusps g r m)) h1)
  simp only [QuotientGroup.mk'_apply, lastCuspsEquiv_mk_cusp] at h2
  exact h2

end Pi1.SurfaceGroup
