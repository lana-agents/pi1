/-!
# Inertia of a basis element of a free profinite group is commensurably terminal

Let `F̂(α)` be the profinite completion of the free group on `α` and `A_a = ⟨a⟩‾` the closed
subgroup topologically generated by a basis element `a`
(`Pi1.Profinite.basisInertia a`). We prove:

* `Pi1.Profinite.mem_basisInertia_of_commute`: the centraliser of `a ^ m` (`m ≥ 1`) lies in
  `A_a`;
* `Pi1.Profinite.commensurator_basisInertia`: **`A_a` is commensurably terminal**: its
  commensurator in `F̂(α)` is `A_a` itself;
* `Pi1.Profinite.basisInertia_inf_conj_eq_bot`: for basis elements `a ≠ b` and any `σ`,
  `A_a ∩ σ A_b σ⁻¹ = 1`.

For the cuspidal generators `c₁, …, c_{r}` of `Π̂_{g,r+1} ≅ F̂(a₁, b₁, …, c_r)` these are the
group-theoretic statements of [AbsTopI] Lemma 4.1 (i) (`Topics in Absolute Anabelian Geometry
I.txt` l.2741–2745: "A ∩ B = {1} … If x_A is a cusp, then A is a torsion-free, commensurably
terminal infinite subgroup of Δ"), see `Pi1.Surface.Commensurator`.

## The argument

* **Abelian characters** `χ_N : F(α) → ℤ/N`, `a ↦ 1`, other generators `↦ 0`, detect `A_a`: an
  element of `A_a` killed by every `χ_N` is trivial (`eq_one_of_mem_basisInertia_of_chi`). Hence
  `σ⁻¹ aᵐ σ ∈ A_a` forces `σ⁻¹ aᵐ σ = aᵐ` (`conj_pow_eq_of_mem`).
* **Centraliser** (wreath-product argument of `Pi1.Profinite.Slim`): if `z` commutes with `aᵐ`,
  `m = 2ʲ m'` with `m'` odd, and `z ∉ A_a`, choose `f₀ : F → P₀` finite with `f̂₀(z) ∉ ⟨f₀ a⟩`
  and put `φ = f₀ × χ_{2^{j+1}}`, `s = φ(a)` of order `o` (divisible by `2^{j+1}`). With the
  homomorphism `ψ = wr ∘ φ` into `𝔽₂ ≀ Q` given by `δ₁` at `a`, `k = a^{o m'}` is in `ker φ`,
  commutes with `z`, and `ψ(k) = wr 1 d` with `d(y) = #{i < o m' | sⁱ y = 1} mod 2`, the
  indicator of `⟨s⟩` (as `m'` is odd). Invariance of `d` under `φ̂(z)` gives `φ̂(z) ∈ ⟨s⟩`,
  contradicting the choice of `f₀`.
* **Commensurator**: if `σ A_a σ⁻¹ ∩ A_a` has finite index in `A_a`, some `aⁿ` (`n ≥ 1`) lies in
  `σ A_a σ⁻¹`; then `σ` commutes with `aⁿ`, so `σ ∈ A_a`.
-/

@[expose] public section

open CategoryTheory ProfiniteGrp ProfiniteGrp.ProfiniteCompletion Topology
open scoped Pointwise

universe u

namespace Pi1.Profinite

open Wreath

variable {G : Type u} [Group G]

/-- Preimages under `liftFinite f` are open. -/
theorem isOpen_liftFinite_preimage {P : Type u} [Group P] [Finite P] (f : G →* P) (T : Set P) :
    IsOpen (liftFinite f ⁻¹' T) := by
  have : liftFinite f ⁻¹' T = ⋃ p ∈ T, {x | liftFinite f x = p} := by
    ext x
    simp
  rw [this]
  exact isOpen_biUnion fun p _ ↦ isOpen_liftFinite_fiber f p

variable {α : Type u}

/-- The image of a basis element `a` in `F̂(α)`. -/
noncomputable abbrev gen (a : α) : FreeHat α := etaFn (GrpCat.of (FreeGroup α)) (FreeGroup.of a)

/-- **The inertia group of a basis element**: `A_a = ⟨a⟩‾ ⊆ F̂(α)`. -/
noncomputable def basisInertia (a : α) : Subgroup (FreeHat α) :=
  (Subgroup.zpowers (gen a)).topologicalClosure

lemma gen_mem_basisInertia (a : α) : gen a ∈ basisInertia a :=
  Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers _)

/-- Elements of `A_a` map into `⟨f a⟩` in every finite quotient. -/
theorem liftFinite_mem_zpowers {P : Type u} [Group P] [Finite P] (f : FreeGroup α →* P)
    {a : α} {z : FreeHat α} (hz : z ∈ basisInertia a) :
    liftFinite f z ∈ Subgroup.zpowers (f (FreeGroup.of a)) := by
  have hle : basisInertia a ≤ (Subgroup.zpowers (f (FreeGroup.of a))).comap (liftFinite f) := by
    refine Subgroup.topologicalClosure_minimal _ ?_ ?_
    · rw [Subgroup.zpowers_le, Subgroup.mem_comap, liftFinite_eta]
      exact Subgroup.mem_zpowers _
    · exact Subgroup.isClosed_of_isOpen _ (by
        rw [Subgroup.coe_comap]
        exact isOpen_liftFinite_preimage f _)
  exact hle hz

/-- `liftFinite` of the quotient map by an open normal subgroup is the quotient map. -/
lemma liftFinite_mk (N : Subgroup (FreeHat α)) [N.Normal] (hN : IsOpen (N : Set (FreeHat α)))
    [Finite (FreeHat α ⧸ N)] (z : FreeHat α) :
    liftFinite ((QuotientGroup.mk' N).comp (eta (GrpCat.of (FreeGroup α))).hom) z =
      QuotientGroup.mk z := by
  obtain ⟨x, hx, hxz⟩ := exists_etaFn_eq
    ((QuotientGroup.mk' N).comp (eta (GrpCat.of (FreeGroup α))).hom)
    (isOpen_setOf_mk_eq N hN z) rfl
  rw [← hxz]
  exact hx

/-- **Membership in `A_a` is detected by finite quotients.** -/
theorem mem_basisInertia_of {a : α} {z : FreeHat α}
    (h : ∀ (P : Type u) [Group P] [Finite P] (f : FreeGroup α →* P),
      liftFinite f z ∈ Subgroup.zpowers (f (FreeGroup.of a))) :
    z ∈ basisInertia a := by
  rw [← SetLike.mem_coe, basisInertia, Subgroup.topologicalClosure_coe, mem_closure_iff_nhds]
  intro U hU
  obtain ⟨V, hVU, hVo, hzV⟩ := mem_nhds_iff.1 hU
  have hV' : IsOpen ((z * ·) ⁻¹' V) := hVo.preimage (continuous_const_mul z)
  obtain ⟨N, hN⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hV'
    (by simpa using hzV)
  haveI : Finite (FreeHat α ⧸ N.toSubgroup) := Subgroup.quotient_finite_of_isOpen _ N.isOpen
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.1
    (h _ ((QuotientGroup.mk' N.toSubgroup).comp (eta (GrpCat.of (FreeGroup α))).hom))
  rw [liftFinite_mk _ N.isOpen] at hn
  simp only [MonoidHom.coe_comp, Function.comp_apply, QuotientGroup.mk'_apply]
    at hn
  have hmem : z⁻¹ * gen a ^ n ∈ N.toSubgroup := by
    rw [← QuotientGroup.eq]
    exact hn.symm
  refine ⟨gen a ^ n, hVU ?_, Subgroup.zpow_mem_zpowers _ _⟩
  have := hN hmem
  simpa using this

/-! ### Abelian characters -/

/-- The character `χ_N : F(α) → ℤ/N`, `a ↦ 1`, `b ↦ 0` for `b ≠ a` (lifted to universe `u`). -/
noncomputable def chi [DecidableEq α] (a : α) (N : ℕ) :
    FreeGroup α →* ULift.{u} (Multiplicative (ZMod N)) :=
  FreeGroup.lift fun b ↦ if b = a then ULift.up (Multiplicative.ofAdd 1) else 1

lemma chi_of_self [DecidableEq α] (a : α) (N : ℕ) :
    chi a N (FreeGroup.of a) = ULift.up (Multiplicative.ofAdd 1) := by
  simp [chi]

lemma chi_of_ne [DecidableEq α] {a b : α} (h : b ≠ a) (N : ℕ) :
    chi a N (FreeGroup.of b) = 1 := by
  simp [chi, h]

lemma orderOf_ofAdd_one (N : ℕ) : orderOf (Multiplicative.ofAdd (1 : ZMod N)) = N := by
  rw [orderOf_ofAdd_eq_addOrderOf, ZMod.addOrderOf_one]

lemma orderOf_chi_of_self [DecidableEq α] (a : α) (N : ℕ) :
    orderOf (chi a N (FreeGroup.of a)) = N := by
  rw [chi_of_self]
  exact (orderOf_injective (MulEquiv.ulift (α := Multiplicative (ZMod N))).toMonoidHom
    MulEquiv.ulift.injective _).symm.trans (orderOf_ofAdd_one N)

/-- **`A_a` is detected by the characters `χ_N`.** -/
theorem eq_one_of_mem_basisInertia_of_chi [DecidableEq α] {a : α} {z : FreeHat α}
    (hz : z ∈ basisInertia a) (hχ : ∀ N [NeZero N], liftFinite (chi a N) z = 1) : z = 1 := by
  refine eq_one_of_forall_liftFinite fun P _ _ f ↦ ?_
  set o := orderOf (f (FreeGroup.of a))
  have ho : o ≠ 0 := (orderOf_pos _).ne'
  haveI : NeZero o := ⟨ho⟩
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.1 (liftFinite_mem_zpowers (f.prod (chi a o)) hz)
  have h1 : liftFinite f z = f (FreeGroup.of a) ^ i := by
    have := liftFinite_comp (f.prod (chi a o)) (MonoidHom.fst _ _) z
    rw [MonoidHom.fst_comp_prod] at this
    rw [this, ← hi]
    simp
  have h2 : (chi a o (FreeGroup.of a)) ^ i = 1 := by
    have := liftFinite_comp (f.prod (chi a o)) (MonoidHom.snd _ _) z
    rw [MonoidHom.snd_comp_prod, hχ o] at this
    rw [this, ← hi]
    simp
  rw [← orderOf_dvd_iff_zpow_eq_one, orderOf_chi_of_self] at h2
  rw [h1]
  exact orderOf_dvd_iff_zpow_eq_one.1 h2

/-- Conjugates of powers of `a` lying in `A_a` are those powers. -/
theorem conj_pow_eq_of_mem {a : α} {σ : FreeHat α} {m : ℕ}
    (h : σ⁻¹ * gen a ^ m * σ ∈ basisInertia a) : σ⁻¹ * gen a ^ m * σ = gen a ^ m := by
  classical
  have hm : gen a ^ m ∈ basisInertia a := pow_mem (gen_mem_basisInertia a) m
  rw [← mul_inv_eq_one]
  refine eq_one_of_mem_basisInertia_of_chi (mul_mem h (inv_mem hm)) fun N _ ↦ ?_
  rw [map_mul, map_mul, map_mul, map_inv, map_inv, mul_comm (liftFinite (chi a N) σ)⁻¹,
    inv_mul_cancel_right, mul_inv_cancel]

/-! ### The centraliser of `aᵐ` -/

section Count

lemma card_filter_dvd_range_mul (o q : ℕ) (ho : 0 < o) :
    ((Finset.range (o * q)).filter (o ∣ ·)).card = q := by
  have : (Finset.range (o * q)).filter (o ∣ ·) = (Finset.range q).map
      ⟨(o * ·), fun x y h ↦ Nat.eq_of_mul_eq_mul_left ho h⟩ := by
    ext i
    simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_map, Function.Embedding.coeFn_mk]
    constructor
    · rintro ⟨hi, j, rfl⟩
      exact ⟨j, by nlinarith, rfl⟩
    · rintro ⟨j, hj, rfl⟩
      exact ⟨by nlinarith, dvd_mul_right _ _⟩
  rw [this, Finset.card_map, Finset.card_range]

lemma cnt_one_mul {Q : Type u} [Group Q] [Finite Q] (s : Q) {q : ℕ} (hq : Odd q) :
    cnt s 1 (orderOf s * q) = 1 := by
  classical
  have ho : 0 < orderOf s := orderOf_pos s
  have : (Finset.range (orderOf s * q)).filter (fun i ↦ s ^ i * 1 = 1) =
      (Finset.range (orderOf s * q)).filter (orderOf s ∣ ·) := by
    ext i
    simp [orderOf_dvd_iff_pow_eq_one]
  rw [cnt, this, card_filter_dvd_range_mul _ _ ho]
  exact ZMod.natCast_eq_one_iff_odd.2 hq

end Count

/-- The invariance argument for a single element `k ∈ ker φ` commuting with `z`. -/
lemma invariant_of_commute_eta {Q : Type u} [Group Q] [Finite Q] (φ : FreeGroup α →* Q)
    (f : α → Q → ZMod 2) (k : FreeGroup α) {d : Q → ZMod 2} (hk : wrHom φ f k = wr 1 d)
    {z : FreeHat α} (hz : z * etaFn _ k = etaFn _ k * z) (x : Q) :
    d (liftFinite φ z * x) = d x := by
  set ψ := wrHom φ f
  obtain ⟨x₀, -, hψ, hφ⟩ := exists_etaFn_eq₂ ψ φ isOpen_univ (Set.mem_univ z)
  obtain ⟨e, he⟩ := wrHom_eq φ f x₀
  have hz' : liftFinite ψ z = wr (liftFinite φ z) e := by rw [← hψ, he, hφ]
  have hc := congrArg (liftFinite ψ) hz
  rw [map_mul, map_mul, liftFinite_eta, hk, hz'] at hc
  exact invariant_of_commute hc x

/-- **The centraliser of `aᵐ` lies in `A_a`** (`m ≥ 1`). -/
theorem mem_basisInertia_of_commute {a : α} {m : ℕ} (hm : m ≠ 0) {z : FreeHat α}
    (hz : z * gen a ^ m = gen a ^ m * z) : z ∈ basisInertia a := by
  classical
  by_contra hzA
  have hex : ∃ (P : Type u) (_ : Group P) (_ : Finite P) (f : FreeGroup α →* P),
      liftFinite f z ∉ Subgroup.zpowers (f (FreeGroup.of a)) := by
    by_contra h
    push Not at h
    exact hzA (mem_basisInertia_of fun P _ _ f ↦ h P _ _ f)
  obtain ⟨P₀, _, _, f₀, hf₀⟩ := hex
  obtain ⟨j, m', hm', rfl⟩ := Nat.exists_eq_two_pow_mul_odd hm
  set E := 2 ^ (j + 1)
  haveI : NeZero E := ⟨by positivity⟩
  set φ := f₀.prod (chi a E)
  set s := φ (FreeGroup.of a)
  set o := orderOf s
  have ho : 0 < o := orderOf_pos s
  have hEo : 2 ^ j ∣ o := by
    have h1 : chi a E (FreeGroup.of a) ^ o = 1 := by
      have := congrArg Prod.snd (pow_orderOf_eq_one s)
      simp only [Prod.pow_snd, Prod.snd_one, s, φ, MonoidHom.prod_apply] at this
      exact this
    rw [← orderOf_dvd_iff_pow_eq_one, orderOf_chi_of_self] at h1
    exact (pow_dvd_pow 2 (Nat.le_succ j)).trans h1
  obtain ⟨o', ho'⟩ := hEo
  set N := o * m'
  -- `k = a ^ N` lies in `ker φ` and commutes with `z`
  set k : FreeGroup α := FreeGroup.of a ^ N
  have hs1 : s ^ o = 1 := pow_orderOf_eq_one s
  have hsN : s ^ N = 1 := by
    change s ^ (o * m') = 1
    rw [pow_mul, hs1, one_pow]
  have hkz : z * etaFn _ k = etaFn _ k * z := by
    have hN : N = 2 ^ j * m' * o' := by
      change o * m' = _
      rw [ho']
      ring
    have hc : Commute z (gen a ^ (2 ^ j * m')) := hz
    have := (hc.pow_right o')
    rw [← pow_mul, ← hN] at this
    have he : etaFn (GrpCat.of (FreeGroup α)) (FreeGroup.of a ^ N) = gen a ^ N :=
      map_pow (eta (GrpCat.of (FreeGroup α))).hom _ _
    change z * etaFn _ (FreeGroup.of a ^ N) = etaFn _ (FreeGroup.of a ^ N) * z
    rw [he]
    exact this
  -- the wreath homomorphism with `δ₁` at `a`
  set f : α → (P₀ × ULift.{u} (Multiplicative (ZMod E))) → ZMod 2 :=
    fun b ↦ if b = a then delta else 0
  have hwr : wrHom φ f (FreeGroup.of a) = wr s delta := by
    simp [wrHom, f, s]
  have hk : wrHom φ f k = wr 1 (fun y ↦ cnt s y N) := by
    calc wrHom φ f k = (wr s delta) ^ N := by
          change wrHom φ f (FreeGroup.of a ^ N) = _
          rw [map_pow, hwr]
      _ = wr (s ^ N) (fun x ↦ ∑ i ∈ Finset.range N, delta (s ^ i * x)) := wr_pow _ _ _
      _ = wr 1 (fun y ↦ cnt s y N) := by
          rw [hsN]
          congr 1
          funext y
          exact sum_delta s y N
  have hinv := invariant_of_commute_eta φ f k hk hkz 1
  rw [mul_one] at hinv
  have h1 : cnt s 1 N = 1 := cnt_one_mul s hm'
  rw [h1] at hinv
  obtain ⟨i, -, hi⟩ := exists_of_cnt_eq_one hinv
  apply hf₀
  have hzs : liftFinite φ z = (s ^ i)⁻¹ := eq_inv_of_mul_eq_one_right hi
  have hfst := liftFinite_comp φ (MonoidHom.fst _ _) z
  rw [MonoidHom.fst_comp_prod, hzs] at hfst
  rw [hfst]
  simp only [MonoidHom.coe_fst, Prod.fst_inv, Prod.pow_fst]
  exact inv_mem (Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _)

/-! ### Commensurable terminality -/

/-- **`A_a` is commensurably terminal in `F̂(α)`.** -/
theorem commensurator_basisInertia (a : α) :
    Subgroup.Commensurable.commensurator (basisInertia a) = basisInertia a := by
  apply le_antisymm
  · intro σ hσ
    rw [Subgroup.Commensurable.commensurator_mem_iff] at hσ
    obtain ⟨n, hn, -, hmem⟩ := Subgroup.exists_pow_mem_of_relIndex_ne_zero hσ.1
      (gen_mem_basisInertia a)
    have h1 : σ⁻¹ * gen a ^ n * σ ∈ basisInertia a := by
      have := (Subgroup.mem_inf.1 hmem).1
      rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ConjAct.smul_def, ConjAct.ofConjAct_inv,
        ConjAct.ofConjAct_toConjAct, inv_inv] at this
      exact this
    have h2 := conj_pow_eq_of_mem h1
    refine mem_basisInertia_of_commute hn.ne' ?_
    calc σ * gen a ^ n = σ * (σ⁻¹ * gen a ^ n * σ) := by rw [h2]
      _ = gen a ^ n * σ := by group
  · intro σ hσ
    rw [Subgroup.Commensurable.commensurator_mem_iff]
    have : ConjAct.toConjAct σ • basisInertia a = basisInertia a := by
      ext x
      rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem]
      simp only [ConjAct.smul_def, map_inv, ConjAct.ofConjAct_toConjAct, inv_inv]
      constructor
      · intro hx
        simpa [mul_assoc] using mul_mem (mul_mem hσ hx) (inv_mem hσ)
      · intro hx
        exact mul_mem (mul_mem (inv_mem hσ) hx) hσ
    rw [this]

/-- **Inertia groups of distinct basis elements meet trivially**, also after conjugation. -/
theorem basisInertia_inf_conj_eq_bot {a b : α} (hab : a ≠ b) (σ : FreeHat α) :
    basisInertia a ⊓ (ConjAct.toConjAct σ • basisInertia b) = ⊥ := by
  classical
  refine (Subgroup.eq_bot_iff_forall _).2 fun z hz ↦ ?_
  obtain ⟨hza, hzb⟩ := Subgroup.mem_inf.1 hz
  rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem] at hzb
  simp only [ConjAct.smul_def, map_inv, ConjAct.ofConjAct_toConjAct, inv_inv] at hzb
  refine eq_one_of_mem_basisInertia_of_chi hza fun N _ ↦ ?_
  have h := liftFinite_mem_zpowers (chi a N) hzb
  rw [chi_of_ne (Ne.symm hab), Subgroup.zpowers_one_eq_bot, Subgroup.mem_bot, map_mul, map_mul,
    map_inv] at h
  have : liftFinite (chi a N) z = liftFinite (chi a N) σ * 1 * (liftFinite (chi a N) σ)⁻¹ := by
    rw [← h]
    group
  rw [this]
  group
